+"""Fixed, bounded collection graphs; observations use public runtime APIs."""
+import json
+from collections.abc import Mapping
+from .model import RecipeError
+from . import fixed_complex
+
+MODES = {**{f'{s}_{r}': 10 for s in ('tsl', 'tsb') for r in ('owned', 'assembled')},
+         **{f'{a}_{b}_{r}': 8 for a in ('tsl', 'tsb') for b in ('tsl', 'tsb') for r in ('owned', 'assembled')},
+         'tsl_tsb_mixed': 8, 'tsb_tsl_mixed': 8,
+         **{f'{s}_ref_{r}': 9 for s in ('tsl', 'tsb') for r in ('whole', 'items')},
+         'tsl_passive': 7, 'tsb_passive': 7, 'tsl_latest_invalid': 6, 'tsb_latest_invalid': 6}
+
+MODES.update({f'{a}_{b}_{r}_invalidate': 9 for a in ('tsl', 'tsb') for b in ('tsl', 'tsb') for r in ('owned', 'assembled')})
+MODES.update(fixed_complex.MODES)
+
+
+def validate(recipe):
+    mode = recipe.parameters.get('mode')
+    if mode not in MODES or recipe.parameters != {'mode': mode}:
+        raise RecipeError('fixed contract mode must name a bounded case')
+    if recipe.to_dict()['inputs'] != {'step': list(range(MODES[mode]))}:
+        raise RecipeError('fixed contract steps must match the bounded case')
+
+
+def execute(hg, recipe):
+    from hgraph.test import eval_node
+    validate(recipe)
+    mode = recipe.parameters['mode']
+    if mode in fixed_complex.MODES:
+        return fixed_complex.execute(hg, recipe)
+    names = mode.split('_')
+    outer = names[0]
+    inner = names[1] if names[1] in ('tsl', 'tsb') else None
+    steps = list(range(MODES[mode]))
+
+    pair_names = iter(("InnerPair", "OuterPair"))
+
+    def pair_type(kind, item):
+        if kind == 'tsl':
+            return hg.TSL[item, hg.Size[2]]
+        class Pair(hg.TimeSeriesSchema):
+            left: item
+            right: item
+        Pair.__name__ = Pair.__qualname__ = next(pair_names)
+        return hg.TSB[Pair]
+
+    item = pair_type(inner, hg.TS[int]) if inner else hg.TS[int]
+    shape = pair_type(outer, item)
+
+    def children(ts, kind):
+        return [ts[0], ts[1]] if kind == 'tsl' else [ts.left, ts.right]
+
+    def convert(v):
+        if isinstance(v, Mapping):
+            return {str(k): convert(x) for k, x in v.items()}
+        if isinstance(v, (tuple, list)):
+            return [convert(x) for x in v]
+        return v
+
+    def snapshot(ts, kind=None, child_kind=None):
+        stamp = ts.last_modified_time
+        result = {'valid': ts.valid, 'modified': ts.modified,
+                  'last': 'never' if stamp == hg.MIN_DT else (stamp-hg.MIN_ST)//hg.MIN_TD,
+                  'value': convert(ts.value) if ts.valid else None,
+                  'delta': convert(ts.delta_value) if ts.modified else None}
+        if kind:
+            keys = ['0', '1'] if kind == 'tsl' else ['left', 'right']
+            result.update(all_valid=ts.all_valid, peer=ts.has_peer,
+                          children={k: snapshot(c, child_kind) for k, c in zip(keys, children(ts, kind))})
+        return result
+
+    def encode(ts):
+        first = snapshot(ts, outer, inner)
+        assert first == snapshot(ts, outer, inner), 'reading changed collection state'
+        return json.dumps(first, sort_keys=True)
+
+    def assemble(typ, kind, left, right):
+        return typ.from_ts(left, right) if kind == 'tsl' else typ.from_ts(left=left, right=right)
+
+    observed = []
+
+    @hg.compute_node(valid=('step',), active=('step',))
+    def observe(step: hg.TS[int], ts: shape) -> hg.TS[str]:
+        encoded = encode(ts)
+        observed.append(json.loads(encoded))
+        return encoded
+
+    if names[1] == 'ref':
+        @hg.compute_node
+        def a_source(step: hg.TS[int], _output: hg.OUT = None) -> shape:
+            a, b = children(_output, outer)
+            if step.value == 0:
+                a.value = 7
+                b.value = 9
+            elif step.value == 3:
+                a.value = 8
+
+        @hg.compute_node
+        def b_source(step: hg.TS[int], _output: hg.OUT = None) -> shape:
+            a, b = children(_output, outer)
+            if step.value == 0:
+                a.value = 20
+                b.value = 30
+            elif step.value == 5:
+                b.value = 31
+
+        @hg.compute_node(valid=('step',), active=('step',))
+        def select(step: hg.TS[int], a: hg.REF[shape], b: hg.REF[shape], mixed: hg.REF[shape], partial: hg.REF[shape]) -> hg.REF[shape]:
+            t = step.value
+            if t in (0, 6) and (t == 0 or names[2] == 'whole'):
+                return hg.TimeSeriesReference.make()
+            if t in (1, 2, 7):
+                return a.value
+            if t == 4:
+                if names[2] == 'whole':
+                    return b.value
+                return mixed.value
+            if t == 6:
+                return partial.value
+
+        @hg.compute_node(valid=('step',), active=('step',))
+        def ref_observe(step: hg.TS[int], ts: shape, a: shape, b: shape, ref: hg.REF[shape]) -> hg.TS[str]:
+            return json.dumps({'data': snapshot(ts, outer), 'a': snapshot(a, outer), 'b': snapshot(b, outer), 'ref_valid': ref.valid, 'ref_modified': ref.modified}, sort_keys=True)
+
+        @hg.compute_node
+        def empty(step: hg.TS[int]) -> hg.REF[hg.TS[int]]:
+            if step.value == 0:
+                return hg.TimeSeriesReference.make()
+
+        @hg.graph
+        def graph(step: hg.TS[int]) -> hg.TS[str]:
+            a, b = a_source(step), b_source(step)
+            mixed = assemble(shape, outer, children(a, outer)[0], children(b, outer)[1])
+            partial = assemble(shape, outer, empty(step), children(b, outer)[1])
+            selected = select(step, a, b, mixed, partial)
+            return ref_observe(step, selected, a, b, selected)
+        trace = eval_node(graph, steps)
+    elif names[1] == 'passive':
+        @hg.graph
+        def graph(step: hg.TS[int], left: hg.TS[int], right: hg.TS[int]) -> hg.TS[str]:
+            return observe(step, assemble(shape, outer, left, right))
+        trace = eval_node(graph, [None, 1, None, None, 4, None, 6], [None, 7, None, 8, None, None, None], [None, None, 9, None, None, 10, None])
+    else:
+        nested = inner is not None
+        invalidate_nested = nested and names[-1] == 'invalidate'
+        role = names[-2] if invalidate_nested else names[-1]
+        # Each source's permitted actions are fixed here, never supplied as code.
+        def action(t, index):
+            if names[1] == 'latest':
+                return {(0, 0): 7, (1, 1): 9, (2, 1): 'invalidate', (4, 1): 11}.get((t, index))
+            if nested:
+                if invalidate_nested and t == 7:
+                    return 'invalidate'
+                return {(1, 0): 7, (2, 2): 9, (3, 1): 8, (5, 3): 10, (6, 0): 11}.get((t, index))
+            if (t, index) in ((4, 0), (5, 1), (7, 0)):
+                return 'invalidate'
+            return {(1, 0): 7, (2, 1): 9, (6, 0): 7, (8, 1): 11}.get((t, index))
+
+        @hg.compute_node
+        def scalar_source(step: hg.TS[int], index: int, _output: hg.OUT = None) -> hg.TS[int]:
+            v = action(step.value, index)
+            if v == 'invalidate':
+                _output.invalidate()
+            elif v is not None:
+                _output.value = v
+
+        @hg.compute_node
+        def owned_source(step: hg.TS[int], _output: hg.OUT = None) -> shape:
+            cs = children(_output, outer)
+            leaves = [c for parent in cs for c in children(parent, inner)] if nested else cs
+            if (not nested or invalidate_nested) and step.value == 7:
+                _output.invalidate()
+            else:
+                for i, c in enumerate(leaves):
+                    v = action(step.value, i)
+                    if v == 'invalidate': c.invalidate()
+                    elif v is not None: c.value = v
+
+        if nested:
+            @hg.compute_node
+            def left_source(step: hg.TS[int], _output: hg.OUT = None) -> item:
+                for i, c in enumerate(children(_output, inner)):
+                    v = action(step.value, i)
+                    if v is not None: c.value = v
+
+        @hg.graph
+        def graph(step: hg.TS[int]) -> hg.TS[str]:
+            if role == 'owned':
+                ts = owned_source(step)
+            elif nested:
+                left = left_source(step) if role == 'mixed' else assemble(item, inner, scalar_source(step, 0), scalar_source(step, 1))
+                right = assemble(item, inner, scalar_source(step, 2), scalar_source(step, 3))
+                ts = assemble(shape, outer, left, right)
+            else:
+                ts = assemble(shape, outer, scalar_source(step, 0), scalar_source(step, 1))
+            return observe(step, ts)
+        try:
+            trace = eval_node(graph, steps)
+        except Exception as error:
+            cause = error
+            while cause.__cause__ or cause.__context__:
+                cause = cause.__cause__ or cause.__context__
+            return {"ticks": observed, "failure": {"type": type(cause).__name__, "message": str(cause).split("\n")[0]}}
+    return {'ticks': [json.loads(t) if t is not None else None for t in trace]}
