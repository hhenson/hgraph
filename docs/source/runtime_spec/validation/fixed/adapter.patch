+"""Bounded nested REF, heterogeneous bundle and graph-boundary observations."""
+import json
+from collections.abc import Mapping
+
+MODES = {**{f'{a}_{b}_ref': 9 for a,b in [('tsl','tsb'),('tsb','tsl')]},
+         'tsb_heterogeneous_owned': 6, 'tsb_heterogeneous_assembled': 6,
+         'tsd_tsl_tsb': 6, 'tsd_tsb_tsl': 6,
+         **{f'{s}_dictionary_{r}': 6 for s in ('tsl','tsb') for r in ('owned','assembled')},
+         **{f'{a}_{b}_graph_{r}': 11 for a,b in [('tsl','tsb'),('tsb','tsl')] for r in ('owned','assembled')}}
+
+
+def execute(hg, recipe):
+    from hgraph.test import eval_node
+    mode = recipe.parameters['mode']
+    names = mode.split('_')
+    dictionary = names[0] == 'tsd'
+    heterogeneous = names[1] == 'heterogeneous'
+    dict_children = names[1] == 'dictionary'
+    outer = names[1] if dictionary else names[0]
+    inner = names[2] if dictionary else ('tsd' if dict_children else None if heterogeneous else names[1])
+    steps = list(range(MODES[mode]))
+    events = []
+
+    def pair_type(kind, item, label, right=None):
+        if kind == 'tsl': return hg.TSL[item, hg.Size[2]]
+        other = right or item
+        class Pair(hg.TimeSeriesSchema):
+            left: item
+            right: other
+        Pair.__name__ = Pair.__qualname__ = label
+        return hg.TSB[Pair]
+
+    item = hg.TSD[str,hg.TS[int]] if dict_children else pair_type(inner, hg.TS[int], 'Inner') if inner else hg.TS[int]
+    shape = pair_type(outer, item, 'Outer', hg.TS[bool] if heterogeneous else None)
+
+    def children(ts, kind):
+        return [ts[0],ts[1]] if kind == 'tsl' else [ts.left,ts.right]
+
+    def leaves(ts):
+        return [c for p in children(ts, outer) for c in children(p, inner)]
+
+    def convert(v):
+        if v is hg.REMOVE or v is hg.REMOVE_IF_EXISTS: return {'$remove':True}
+        if isinstance(v, Mapping): return {str(k):convert(x) for k,x in v.items()}
+        if isinstance(v, (tuple,list)): return [convert(x) for x in v]
+        return v
+
+    def snapshot(ts, kind=None, child_kind=None, peering=True):
+        stamp=ts.last_modified_time
+        result={'valid':ts.valid,'modified':ts.modified,'last':'never' if stamp==hg.MIN_DT else (stamp-hg.MIN_ST)//hg.MIN_TD,'value':convert(ts.value) if ts.valid else None,'delta':convert(ts.delta_value) if ts.modified else None}
+        if kind=='tsd':
+            result.update(all_valid=ts.all_valid,peer=ts.has_peer,children={k:snapshot(v) for k,v in ts.items()})
+        elif kind:
+            keys=['0','1'] if kind=='tsl' else ['left','right']
+            result.update(all_valid=ts.all_valid,children={k:snapshot(c,child_kind,peering=peering) for k,c in zip(keys,children(ts,kind))})
+            if peering: result['peer']=ts.has_peer
+        return result
+
+    def assemble(typ,kind,left,right):
+        return typ.from_ts(left,right) if kind=='tsl' else typ.from_ts(left=left,right=right)
+
+    @hg.compute_node(valid=('step',),active=('step',))
+    def observe(step:hg.TS[int],ts:shape)->hg.TS[str]:
+        first=snapshot(ts,outer,inner)
+        assert first==snapshot(ts,outer,inner), 'observation changed collection state'
+        return json.dumps(first,sort_keys=True)
+
+    if dict_children:
+        def change(ts,t,index):
+            if index==0:
+                if t in (0,4): ts.get_or_create('X').value=7 if t==0 else 11
+                elif t==2: del ts['X']
+            elif t==1: ts.get_or_create('Y').value=9
+
+        @hg.compute_node
+        def owned(step:hg.TS[int],_output:hg.OUT=None)->shape:
+            for index,ts in enumerate(children(_output,outer)): change(ts,step.value,index)
+
+        @hg.compute_node
+        def child(step:hg.TS[int],index:int,_output:hg.OUT=None)->item:
+            change(_output,step.value,index)
+
+        @hg.graph
+        def graph(step:hg.TS[int])->hg.TS[str]:
+            ts=owned(step) if names[-1]=='owned' else assemble(shape,outer,child(step,0),child(step,1))
+            return observe(step,ts)
+        trace=eval_node(graph,steps)
+    elif heterogeneous:
+        @hg.compute_node
+        def source(step:hg.TS[int],_output:hg.OUT=None)->shape:
+            t=step.value
+            if t in (1,3): _output.left.value=7 if t==1 else 8
+            if t in (2,4): _output.right.value=t==4
+
+        @hg.graph
+        def graph(step:hg.TS[int],left:hg.TS[int],right:hg.TS[bool])->hg.TS[str]:
+            ts=source(step) if names[-1]=='owned' else assemble(shape,outer,left,right)
+            return observe(step,ts)
+        trace=eval_node(graph,steps,[None,7,None,8,None,None],[None,None,False,None,True,None])
+    elif dictionary:
+        @hg.compute_node
+        def source(step:hg.TS[int],_output:hg.OUT=None)->hg.TSD[str,shape]:
+            t=step.value
+            if t in (0,1,4):
+                row=_output.get_or_create('X')
+                leaves(row)[2 if t==1 else 0].value={0:7,1:9,4:11}[t]
+            elif t==2: del _output['X']
+
+        @hg.compute_node(valid=('step',),active=('step',))
+        def observe_dict(step:hg.TS[int],ts:hg.TSD[str,shape])->hg.TS[str]:
+            stamp=ts.last_modified_time
+            return json.dumps({'valid':ts.valid,'all_valid':ts.all_valid,'modified':ts.modified,'last':'never' if stamp==hg.MIN_DT else (stamp-hg.MIN_ST)//hg.MIN_TD,'keys':sorted(ts.keys()),'added':sorted(ts.added_keys()),'removed':sorted(ts.removed_keys()),'children':{k:snapshot(v,outer,inner,False) for k,v in ts.items()},'retired':{k:snapshot(v,outer,inner,False) for k,v in ts.removed_items()},'delta':convert(ts.delta_value) if ts.modified else None},sort_keys=True)
+
+        @hg.graph
+        def graph(step:hg.TS[int])->hg.TS[str]: return observe_dict(step,source(step))
+        trace=eval_node(graph,steps)
+    elif names[-1]=='ref':
+        @hg.compute_node
+        def source(step:hg.TS[int],which:int,_output:hg.OUT=None)->shape:
+            t=step.value;cs=leaves(_output)
+            if t==0:
+                for i,v in ([(0,7),(2,9)] if which==0 else [(0,20),(1,21)]): cs[i].value=v
+            elif t==3 and which==0: cs[1].value=8
+            elif t==5 and which==1: cs[2].value=30
+
+        @hg.compute_node(valid=('step',),active=('step',))
+        def select(step:hg.TS[int],a:hg.REF[shape],b:hg.REF[shape])->hg.REF[shape]:
+            t=step.value
+            if t in (0,6): return hg.TimeSeriesReference.make()
+            if t in (1,2,7): return a.value
+            if t==4: return b.value
+
+        @hg.graph
+        def graph(step:hg.TS[int])->hg.TS[str]:
+            return observe(step,select(step,source(step,0),source(step,1)))
+        trace=eval_node(graph,steps)
+    else:
+        @hg.compute_node
+        def total(ts:shape,_state:hg.STATE=None,_scheduler:hg.SCHEDULER=None)->hg.TS[int]:
+            if ts.modified:
+                _state.total += leaves(ts)[0].value
+                _scheduler.schedule(hg.MIN_TD*2,'timer')
+                return _state.total
+            if _scheduler.is_scheduled_now: return -_state.total
+
+        @total.start
+        def start(_state:hg.STATE):
+            _state.total=0;events.append('start')
+
+        @total.stop
+        def stop(): events.append('stop')
+
+        @hg.compute_node(valid=('selector',),active=('selector',))
+        def select(selector:hg.TS[int],a:hg.REF[shape],b:hg.REF[shape])->hg.REF[shape]:
+            return a.value if selector.value==0 else b.value
+
+        @hg.graph
+        def per_key(selector:hg.TS[int],a:shape,b:shape)->hg.TS[int]:
+            return total(select(selector,a,b))
+
+        @hg.graph
+        def inner_graph(selectors:hg.TSD[str,hg.TS[int]],a:shape,b:shape)->hg.TSD[str,hg.TS[int]]:
+            return hg.map_(per_key,selectors,hg.pass_through(a),hg.pass_through(b))
+
+        @hg.compute_node
+        def owned(v:hg.TS[int],_output:hg.OUT=None)->shape:
+            leaves(_output)[0].value=v.value
+
+        @hg.graph
+        def collection(v:hg.TS[int])->shape:
+            if names[-1]=='owned': return owned(v)
+            nil=hg.nothing(hg.TS[int])
+            return assemble(shape,outer,assemble(item,inner,v,nil),assemble(item,inner,nil,nil))
+
+        @hg.graph
+        def graph(selectors:hg.TSD[str,hg.TS[int]],a:hg.TS[int],b:hg.TS[int])->hg.TSD[str,hg.TS[int]]:
+            return hg.switch_(hg.const(True),{True:inner_graph},selectors,collection(a),collection(b))
+        trace=eval_node(graph,[{'X':0},None,{'X':1},None,None,{'X':hg.REMOVE},None,{'X':0},None,None,None],[2,3,None,4,None,None,5,None,None,None,None],[10]+[None]*10,__end_time__=hg.MIN_ST+len(steps)*hg.MIN_TD)
+        return {'ticks':convert(trace),'events':events}
+    return {'ticks':[json.loads(t) if t is not None else None for t in trace]}
