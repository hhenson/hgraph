# Recursive struct fields (ADR 0012) through direct wiring: construction,
# equality through the whole depth, scalar-boundary eval checks, edges through a
# second struct, a generic application and an abstract family, and the finite
# temporal shape whose recursive edge is one endpoint.

module tests.recursive_structs

struct Node {
    value: i64
    next: atomic<Node> = null
}

struct A {
    tag: str
    b: atomic<B> = null
}

struct B {
    a: atomic<A> = null
}

struct Tree<T> {
    value: T
    left: atomic<Tree<T>> = null
}

struct Pair<X, Y> {
    first: X
    swapped: atomic<Pair<Y, X>> = null
}

abstract struct Expr {
    note: str = "e"
}

struct Add: Expr {
    lhs: atomic<Expr> = null
}

abstract struct Linked {
    next: atomic<Linked> = null
}

struct Item: Linked {
    value: i64
}

struct Holder {
    first: Node
    count: i64
}

export fn three(x: i64) -> atomic<Node> => Node(value: 1, next: Node(value: 2, next: Node(value: 3)))
export fn pass_node(x: atomic<Node>) -> atomic<Node> => x
export fn head(x: atomic<Node>) -> atomic<Node> => x.next
export fn pass_pair(x: atomic<A>) -> atomic<A> => x
export fn pass_tree(x: atomic<Tree<i64>>) -> atomic<Tree<i64>> => x
export fn pass_swapped(x: atomic<Pair<i64, str>>) -> atomic<Pair<i64, str>> => x
export fn pass_add(x: atomic<Add>) -> atomic<Add> => x
export fn pass_item(x: atomic<Item>) -> atomic<Item> => x
export fn pass_holder(x: atomic<Holder>) -> atomic<Holder> => x

export fn wrap(v: i64, n: atomic<Node>) -> Node => Node(value: v, next: n)
export fn unwrap(v: i64, n: atomic<Node>) -> atomic<Node> => wrap(v, n).next
export fn root_value(v: i64, n: atomic<Node>) -> i64 => wrap(v, n).value


# Eval's scalar boundaries keep recursive values inside the graph.
fn three_value(x: i64) -> i64 => three(x).next.next.value
fn round_trip_value(x: i64) -> i64 => pass_node(Node(value: x, next: Node(value: 2, next: Node(value: 3)))).value
fn depth_equal(x: i64) -> bool => pass_node(Node(value: 1, next: Node(value: 2, next: Node(value: x)))) == Node(value: 1, next: Node(value: 2, next: Node(value: 3)))
fn head_value(x: i64) -> i64 => head(Node(value: 1, next: Node(value: x, next: Node(value: 3)))).value
fn pair_tag(tag: str) -> str => pass_pair(A(tag: "x", b: B(a: A(tag: tag)))).b.a.tag
fn tree_value(x: i64) -> i64 => pass_tree(Tree<i64>(value: 1, left: Tree<i64>(value: x))).left.value
fn swapped_value(x: str) -> str => pass_swapped(Pair<i64, str>(first: 1, swapped: Pair<str, i64>(first: x))).swapped.first
fn add_equal(x: i64) -> bool => pass_add(Add(lhs: null)) == Add()
fn item_value(x: i64) -> i64 => pass_item(Item(value: x)).value
fn holder_value(x: i64) -> i64 => pass_holder(Holder(first: Node(value: 1, next: Node(value: x)), count: 3)).first.next.value
fn unwrapped_value(x: i64) -> i64 => unwrap(1, Node(value: x, next: Node(value: 3))).value
fn wrapped_value(x: i64) -> i64 => root_value(x, Node(value: 2))

test three_deep { assert eval(three_value, x: [0]) == [3] }
test round_trip { assert eval(round_trip_value, x: [1, 4]) == [1, 4] }
test compared_at_depth { assert eval(depth_equal, x: [3, 4]) == [true, false] }
test field_access { assert eval(head_value, x: [2]) == [2] }
test mutual_pair { assert eval(pair_tag, tag: ["y"]) == ["y"] }
test generic_edges {
    assert eval(tree_value, x: [2]) == [2]
    assert eval(swapped_value, x: ["s"]) == ["s"]
}
test abstract_edges {
    assert eval(add_equal, x: [0]) == [true]
    assert eval(item_value, x: [1]) == [1]
}
test held_inline { assert eval(holder_value, x: [2]) == [2] }
test temporal_shape {
    assert eval(unwrapped_value, x: [2]) == [2]
    assert eval(wrapped_value, x: [1]) == [1]
}
