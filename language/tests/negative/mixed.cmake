cmake_minimum_required(VERSION 3.25)
file(READ "${MANIFEST}" manifest)
get_filename_component(root "${MANIFEST}" DIRECTORY)
string(JSON count LENGTH "${manifest}" cases)
math(EXPR last "${count} - 1")
foreach(index RANGE 0 ${last})
    string(JSON case GET "${manifest}" cases ${index})
    string(JSON preflight GET "${case}" preflight)
    if(preflight)
        continue() # Runtime error assertions have their own portable generated gate.
    endif()
    string(JSON id GET "${case}" id)
    string(JSON file GET "${case}" file)
    string(JSON expected GET "${case}" expected_exit)
    get_filename_component(file "${root}/${file}" ABSOLUTE)
    set(arguments test "${file}")
    foreach(field IN ITEMS select parts)
        string(JSON length ERROR_VARIABLE absent LENGTH "${case}" ${field})
        if(NOT absent)
            math(EXPR field_last "${length} - 1")
            foreach(i RANGE 0 ${field_last})
                string(JSON value GET "${case}" ${field} ${i})
                if(field STREQUAL parts)
                    get_filename_component(value "${root}/${value}" ABSOLUTE)
                    list(APPEND arguments --part "${value}")
                else()
                    list(APPEND arguments "${value}")
                endif()
            endforeach()
        endif()
    endforeach()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env HGL_CXX=hgl-mixed-must-not-build HGL_DISABLE_CACHE=1
        "${HGL}" ${arguments} RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(NOT "${status}" STREQUAL "${expected}")
        message(FATAL_ERROR "${id}: expected exit ${expected}, got ${status}\n${output}\n${errors}")
    endif()
    foreach(field IN ITEMS runtime_results rejection_results)
        string(JSON length ERROR_VARIABLE absent LENGTH "${case}" ${field})
        if(absent)
            continue()
        endif()
        math(EXPR field_last "${length} - 1")
        foreach(i RANGE 0 ${field_last})
            string(JSON outcome GET "${case}" ${field} ${i} outcome)
            if(outcome STREQUAL passed)
                set(marker ok)
            else()
                set(marker FAILED)
            endif()
            if(field STREQUAL runtime_results)
                set(kind executed)
            else()
                set(kind rejection)
            endif()
            string(JSON name ERROR_VARIABLE unnamed GET "${case}" ${field} ${i} name)
            if(NOT unnamed)
                string(FIND "${output}" "${name} ... ${marker} [${kind}]" position)
            else()
                string(JSON file GET "${case}" ${field} ${i} file)
                string(JSON line GET "${case}" ${field} ${i} owner_line)
                get_filename_component(file "${root}/${file}" ABSOLUTE)
                set(position -1)
                string(REPLACE "\n" ";" result_lines "${output}")
                foreach(result_line IN LISTS result_lines)
                    string(FIND "${result_line}" "${file}:${line}" prefix)
                    string(FIND "${result_line}" " ... ${marker} [${kind}]" suffix)
                    if(prefix EQUAL 0 AND NOT suffix EQUAL -1)
                        set(position 0)
                    endif()
                endforeach()
            endif()
            if(position EQUAL -1)
                message(FATAL_ERROR "${id}: missing ${kind} result ${name}/${file}:${line}\n${output}\n${errors}")
            endif()
        endforeach()
    endforeach()
    string(JSON length ERROR_VARIABLE absent LENGTH "${case}" not_executed)
    if(NOT absent)
        math(EXPR field_last "${length} - 1")
        foreach(i RANGE 0 ${field_last})
            string(JSON name GET "${case}" not_executed ${i})
            foreach(marker IN ITEMS ok FAILED)
                string(FIND "${output}" "${name} ... ${marker} [executed]" position)
                if(NOT position EQUAL -1)
                    message(FATAL_ERROR "${id}: excluded ${name} executed\n${output}\n${errors}")
                endif()
            endforeach()
        endforeach()
    endif()
endforeach()
