module tests.negative_cleanup

cpp include <hgl/execution_error.h>
cpp include <stdexcept>

native const fn cleanup_failure(value: i64) -> i64 throws {
    cpp(hgraph::Int value) {
        if (value == 1) { throw std::runtime_error("cleanup sentinel"); }
        return value;
    }
}
native const fn coded_cleanup_failure(value: i64) -> i64 throws {
    cpp(hgraph::Int value) {
        if (value == 1) { throw hgl::ExecutionError("yield.negative_duration", "coded cleanup sentinel"); }
        return value;
    }
}
native const fn uncoded_failure(value: i64) -> i64 throws {
    cpp(hgraph::Int value) {
        if (value == 1) { throw std::runtime_error("yield.negative_duration"); }
        return value;
    }
}
fn with_cleanup(trigger: i64) -> i64 {
    when { return trigger }
    stop { cleanup_failure(1) }
}
fn with_coded_cleanup(trigger: i64) -> i64 {
    when { return trigger }
    stop { coded_cleanup_failure(1) }
}
fn uncoded(trigger: i64) -> i64 {
    when { return uncoded_failure(trigger) }
}
fn negative_delay() -> i64 {
    yield -1us: 1
}
fn combined(trigger: i64) -> i64 {
    let watching = with_cleanup(trigger)
    return negative_delay() + watching
}
test cleanup_only {
    assert raises("yield.negative_duration") {
        eval(with_cleanup, trigger: [1])
    }
}
test coded_cleanup_only {
    assert raises("yield.negative_duration") {
        eval(with_coded_cleanup, trigger: [1])
    }
}
test combined_failure {
    assert raises("yield.negative_duration") {
        eval(combined, trigger: [1])
    }
}
test uncoded_message {
    assert raises("yield.negative_duration") {
        eval(uncoded, trigger: [1])
    }
}
test continuation { assert true }
