# The importing side: the struct is REFERRED to, never re-declared. A value
# built here IS the exporting module's type, and a local struct extends the
# imported family.
module checks.imported_struct_consumer

use checks.imported_shapes as shapes
use checks.imported_shapes::{Equity}

# Extending a family a library publishes -- the reason a library is worth
# having, so it is part of the decision rather than a later question.
export struct Future: shapes::Instrument
{
    expiry: i64
}

# Inherited from the imported parent, and declared here.
export fn future_symbol(future: atomic<Future>) -> str => future.symbol
export fn future_expiry(future: atomic<Future>) -> i64 => future.expiry
# Constructing the imported struct itself, in both spellings.
export fn build(lot: i64) -> atomic<Equity> => Equity(symbol: "eq", lot: lot)
export fn build_qualified(lot: i64) -> atomic<shapes::Equity> => shapes::Equity(symbol: "q", lot: lot)
export fn equity_lot(equity: atomic<shapes::Equity>) -> i64 => equity.lot
# The imported RECURSIVE struct rebuilds its edge here (ADR 0012's acceptance
# item), and this module compiles, so the generated backend carries it too.
export fn next_tenor(leg: atomic<shapes::Leg>) -> str => leg.next.tenor

fn future_symbol_from_expiry(expiry: i64) -> str => future_symbol(Future(symbol: "fu", expiry: expiry))
fn future_expiry_from_expiry(expiry: i64) -> i64 => future_expiry(Future(symbol: "fu", expiry: expiry))
fn equity_lot_from_lot(lot: i64) -> i64 => equity_lot(Equity(symbol: "eq", lot: lot))
fn built_lot(lot: i64) -> i64 => equity_lot(build(lot))
fn qualified_lot(lot: i64) -> i64 => equity_lot(build_qualified(lot))
fn nested_tenor(tenor: str) -> str => next_tenor(shapes::Leg(tenor: "1Y", next: shapes::Leg(tenor: tenor)))

test {
    # A field a local child inherits from a struct ANOTHER module declares.
    test inherited_field {
        assert eval(future_symbol_from_expiry, expiry: [3]) == ["fu"]
    }
    test own_field {
        assert eval(future_expiry_from_expiry, expiry: [3]) == [3]
    }
    # Constructed here, read back here: one schema, no conversion between.
    test construct_imported {
        assert eval(equity_lot_from_lot, lot: [7]) == [7]
    }
    test round_trip_imported {
        assert eval(built_lot, lot: [5]) == [5]
    }
    test imported_recursive_edge {
        assert eval(nested_tenor, tenor: ["2Y"]) == ["2Y"]
    }
    # The alias spelling and the `use` spelling share one binding.
    test round_trip_qualified {
        assert eval(qualified_lot, lot: [5]) == [5]
    }
}
