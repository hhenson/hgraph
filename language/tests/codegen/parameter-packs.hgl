module checks.parameter_packs

use hgraph.std::{all_, null_sink}

fn all_inputs(inputs: ...bool) -> bool =>
    all_(inputs)

export fn forward_all(values: ...bool) -> bool =>
    all_inputs(values)

export fn positional<...Ts>(values: ...Ts) {
    for value in elements(values) {
        null_sink(value)
    }
    for index, value in items(values) {
        null_sink(value)
    }
}

export fn keyword<...Fields>(values: ...{Fields}) {
    for name in keys(values) {
        null_sink(name)
    }
    for name, value in items(values) {
        null_sink(value)
    }
}

export fn route(price: f64, symbol: str) {
    positional(price, symbol)
    keyword(price: price, symbol: symbol)
}

export fn route_constants(price: f64) -> f64 {
    positional(price, 7, "tag")
    keyword(price: price, count: 7, label: "tag")
    return price
}

export fn route_all(left: bool, right: bool) -> bool =>
    forward_all(left, right)
