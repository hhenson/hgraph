# The first runtime-node backend fixture. It is emitted and compiled both as
# a package through hgl_add_module() and as a transient scripted image through
# `hgl test`, then evaluated through hgraph's public wiring/runtime surface.

module hgl.codegen.runtime

export fn tuple_result(value: i64) -> tuple<i64, bool> {
    when { return (value, true) }
}

export fn tuple_patch(value: i64) -> tuple<i64, bool> {
    when {
        if value == 1 { return delta<tuple<i64, bool>>(items: [0: value]) }
        return delta<tuple<i64, bool>>(items: [1: true])
    }
}

export fn tuple_forward(value: tuple<i64, bool>) -> tuple<i64, bool> {
    when { return delta_value(value) }
}

export fn nested_tuple_result(value: i64) -> tuple<tuple<i64, bool>, i64> {
    when { return ((value, value > 0), value) }
}

export fn tuple_complete_forward(value: tuple<i64, bool>) -> tuple<i64, bool> {
    when { return value }
}

export fn tuple_first(value: tuple<i64, bool>) -> i64 {
    when modified(value[0]) && valid(value[0]) { return value[0] }
}

export fn tuple_second(value: tuple<i64, bool>) -> bool {
    when modified(value[1]) && valid(value[1]) { return value[1] }
}

export fn tuple_local_read(value: i64) -> bool {
    when {
        let pair = (value, value > 0)
        return pair[1]
    }
}

export fn nested_tuple_first(value: tuple<tuple<i64, bool>, i64>) -> i64 {
    when modified(value[0][0]) && valid(value[0][0]) { return value[0][0] }
}

export fn tuple_observation_copy(value: tuple<i64, bool>) -> i64 {
    when all_valid(value) {
        let copy = value
        return copy[0]
    }
}

export fn tuple_embed_input(value: tuple<i64, bool>) -> tuple<tuple<i64, bool>, i64> {
    when all_valid(value) { return (value, 1) }
}

export fn tuple_embed_copy(value: tuple<i64, bool>) -> tuple<tuple<i64, bool>, i64> {
    when all_valid(value) {
        let copy = value
        return (copy, 1)
    }
}

export fn nested_tuple_observation_copy(value: tuple<tuple<i64, bool>, i64>) -> bool {
    when all_valid(value) {
        let copy = value
        return copy[0][1]
    }
}

export fn tuple_observed_generic<T>(value: tuple<T, bool>) -> tuple<T, bool> {
    when all_valid(value) {
        let copy = value
        return copy
    }
}
export fn tuple_observed_generic_int(value: tuple<i64, bool>) -> tuple<i64, bool> => tuple_observed_generic(value)

export fn tuple_list_observe(value: tuple<list<tuple<i64, bool>, 2>, bool>) -> bool {
    when all_valid(value) {
        let copy = value
        return copy[0][0][1]
    }
}

export fn tuple_list_copy(value: tuple<list<tuple<i64, bool>, 2>, bool>) -> tuple<list<tuple<i64, bool>, 2>, bool> {
    when all_valid(value) {
        let copy = value
        return copy
    }
}

export fn tuple_list_first(value: tuple<list<tuple<i64, bool>, 2>, bool>) -> tuple<i64, bool> {
    when valid(value[0]) && all_valid(at(value[0], 0)) {
        let copy = at(value[0], 0)
        return copy
    }
}

export fn tuple_map_copy(value: tuple<map<i64, tuple<i64, bool>>, bool>) -> tuple<map<i64, tuple<i64, bool>>, bool> {
    when all_valid(value) {
        let copy = value
        return copy
    }
}

export fn tuple_collection_result(value: i64) -> tuple<list<tuple<i64, bool>, 2>, map<i64, tuple<i64, bool>>> {
    when {
        let pairs: list<tuple<i64, bool>, 2> = [(7, false), (8, true)]
        return (pairs, map<i64, tuple<i64, bool>>(items: [4: (value, false)]))
    }
}

export fn tuple_observed_present_field(value: tuple<i64, bool>) -> i64 {
    when valid(value) && valid(value[0]) {
        let copy = value
        return copy[0]
    }
}

export fn tuple_observed_partial_result(value: tuple<i64, bool>) -> tuple<i64, bool> {
    when valid(value) && valid(value[0]) {
        let copy = value
        return copy
    }
}

export fn tuple_list_observed_partial_result(value: tuple<list<tuple<i64, bool>, 2>, bool>) -> tuple<list<tuple<i64, bool>, 2>, bool> {
    when valid(value) && valid(value[0]) && valid(at(value[0], 0)) {
        let copy = value
        return copy
    }
}

export fn tuple_observed_absent_field(value: tuple<i64, bool>) -> bool {
    when valid(value) && valid(value[0]) {
        let copy = value
        return copy[1]
    }
}

export fn tuple_list_observed_absent_field(value: tuple<list<tuple<i64, bool>, 2>, bool>) -> bool {
    when valid(value) && valid(value[0]) && valid(at(value[0], 0)) {
        let copy = value
        return copy[0][0][1]
    }
}

export fn tuple_list_observed_absent_slot(value: tuple<list<tuple<i64, bool>, 2>, bool>) -> i64 {
    when valid(value) && valid(value[0]) && valid(at(value[0], 0)) {
        let copy = value
        return copy[0][1][0]
    }
}

export fn tuple_list_observed_absent_length(value: tuple<list<tuple<i64, bool>, 2>, bool>) -> i64 {
    when valid(value) && valid(value[1]) {
        let copy = value
        return len(copy[0])
    }
}

export fn tuple_map_observed_partial(value: tuple<map<i64, tuple<i64, bool>>, bool>) -> tuple<map<i64, tuple<i64, bool>>, bool> {
    when valid(value) && valid(value[0]) {
        let copy = value
        return copy
    }
}

test structural_tuple_complete_and_sparse_results {
    assert eval(tuple_result, [1, 1, _, 2]) == [(1, true), (1, true), _, (2, true)]
    assert eval(tuple_patch, [1, 2, 2, 1]) == [(1, _), (_, true), (_, true), (1, _)]
    assert eval(nested_tuple_result, [1, 1, _, -2]) == [((1, true), 1), ((1, true), 1), _, ((-2, false), -2)]
}

test concrete_tuple_delta_forwarding {
    assert eval(tuple_forward, [(1, _), (_, true), (1, _), _]) == [(1, _), (_, true), (1, _), _]
}

test tuple_input_complete_returns_and_guarded_reads {
    assert eval(tuple_complete_forward, [(7, false), (_, true), (9, _)]) == [(7, false), (7, true), (9, true)]
    assert eval(tuple_first, [(_, false), (7, _), (_, true), (9, _), _]) == [_, 7, _, 9, _]
    assert eval(tuple_second, [(_, false), (7, _), (_, true), (9, _), _]) == [false, _, true, _, _]
    assert eval(tuple_local_read, [1, -1, 0]) == [true, false, false]
    assert eval(nested_tuple_first, [((_, false), _), ((7, _), _), (_, 9)]) == [_, 7, _]
}

test tuple_observations_become_owned_ordinary_values {
    assert eval(tuple_observation_copy, [(7, false), (_, true), (9, _)]) == [7, 7, 9]
    assert eval(tuple_embed_input, [(7, false), (_, true), (9, _)]) == [((7, false), 1), ((7, true), 1), ((9, true), 1)]
    assert eval(tuple_embed_copy, [(7, false), (_, true), (9, _)]) == [((7, false), 1), ((7, true), 1), ((9, true), 1)]
    assert eval(nested_tuple_observation_copy, [((7, false), 1), ((_, true), _), (_, 2)]) == [false, true, true]
    assert eval(tuple_observed_generic_int, [(7, false), (_, true), (9, _)]) == [(7, false), (7, true), (9, true)]
}

test tuple_observations_convert_nested_collection_children {
    let pair_a = delta<tuple<i64, bool>>(items: [0: 7, 1: false])
    let pair_b = delta<tuple<i64, bool>>(items: [0: 8, 1: true])
    let list_input = delta<tuple<list<tuple<i64, bool>, 2>, bool>>(items: [
        0: delta<list<tuple<i64, bool>, 2>>(items: [0: pair_a, 1: pair_b]), 1: true])
    let list_tick = delta<tuple<list<tuple<i64, bool>, 2>, bool>>(items: [1: false])
    let list_snapshot = delta<tuple<list<tuple<i64, bool>, 2>, bool>>(items: [
        0: delta<list<tuple<i64, bool>, 2>>(items: [0: pair_a, 1: pair_b]), 1: false])
    assert eval(tuple_list_observe, [list_input, list_tick, _, list_tick]) == [false, false, _, false]
    assert eval(tuple_list_copy, [list_input, list_tick, _, list_tick]) == [list_input, list_snapshot, _, list_snapshot]
    assert eval(tuple_list_first, [list_input, list_tick, _, list_tick]) == [(7, false), (7, false), _, (7, false)]
    let map_input = delta<tuple<map<i64, tuple<i64, bool>>, bool>>(items: [
        0: delta<map<i64, tuple<i64, bool>>>(upsert: [4: pair_a, 5: pair_b]), 1: true])
    let map_remove = delta<tuple<map<i64, tuple<i64, bool>>, bool>>(items: [
        0: delta<map<i64, tuple<i64, bool>>>(remove: [5])])
    let map_snapshot = delta<tuple<map<i64, tuple<i64, bool>>, bool>>(items: [
        0: delta<map<i64, tuple<i64, bool>>>(upsert: [4: pair_a], remove: [5]), 1: true])
    assert eval(tuple_map_copy, [map_input, _, map_remove]) == [map_input, _, map_snapshot]
    let result = delta<tuple<list<tuple<i64, bool>, 2>, map<i64, tuple<i64, bool>>>>(items: [
        0: delta<list<tuple<i64, bool>, 2>>(items: [0: pair_a, 1: pair_b]),
        1: delta<map<i64, tuple<i64, bool>>>(upsert: [4: pair_a])])
    assert eval(tuple_collection_result, [7, _, 7]) == [result, _, result]
}

test tuple_observations_retain_present_sparse_fields {
    assert eval(tuple_observed_present_field, [(7, _), _, (9, _)]) == [7, _, 9]
    assert eval(tuple_observed_absent_field, [(7, false), (_, true)]) == [false, true]
    assert eval(tuple_complete_forward, [(7, _)]) == [(7, _)]
    assert eval(tuple_observed_partial_result, [(7, _)]) == [(7, _)]
    let sparse_list = delta<tuple<list<tuple<i64, bool>, 2>, bool>>(items: [
        0: delta<list<tuple<i64, bool>, 2>>(items: [0: delta<tuple<i64, bool>>(items: [0: 7])]), 1: true])
    assert eval(tuple_list_observed_partial_result, [sparse_list]) == [sparse_list]
    let partial = delta<tuple<map<i64, tuple<i64, bool>>, bool>>(items: [
        0: delta<map<i64, tuple<i64, bool>>>(upsert: [4: delta<tuple<i64, bool>>(items: [0: 7])]), 1: true])
    assert eval(tuple_map_observed_partial, [partial]) == [partial]
}

cpp include <hgraph/types/metadata/ts_value_type_meta_data.h>

native fn known_schema(value: schema) -> bool {
    cpp(const hgraph::TSValueTypeMetaData *value) {
        return value != nullptr;
    }
}

operator absolute(value: f64) -> f64
operator all_runtime(values: ...bool{2}) -> bool
operator positional_count<...Ts>(values: ...Ts) -> i64
operator named_count<...Fields>(values: ...{Fields}) -> i64
operator homogeneous_schema_count<T>(values: ...T) -> i64
operator triggered_schema_count<T>(trigger: signal, values: ...T) -> i64
operator positional_schema_count<...Ts>(values: ...Ts) -> i64
operator named_schema_count<...Fields>(values: ...{Fields}) -> i64

impl fn absolute(value: f64) -> f64 {
    when modified(value) && valid(value) {
        if value < 0.0 {
            return -value
        }
        return value
    }
}

impl fn all_runtime(values: ...bool{2}) -> bool {
    when {
        var result = true
        for value in elements(values, valid) {
            result = result && value
        }
        return result
    }
}

impl fn positional_count<...Ts>(values: ...Ts) -> i64 {
    when {
        var count = 0
        for index, value in items(values) {
            if valid(value) && (index == 0 || index == 1) {
                count += 1
            }
        }
        return count
    }
}

impl fn named_count<...Fields>(values: ...{Fields}) -> i64 {
    when {
        var count = 0
        for name in keys(values, valid) {
            if name == "a" || name == "b" {
                count += 1
            }
        }
        return count
    }
}

impl fn homogeneous_schema_count<T>(values: ...T) -> i64 {
    when {
        var count = 0
        for value_schema in elements(schemas(values)) {
            if known_schema(value_schema) {
                count += 1
            }
        }
        return count
    }
}

impl fn triggered_schema_count<T>(trigger: signal, values: ...T) -> i64 {
    when modified(trigger) && valid(trigger) {
        var count = 0
        for value_schema in elements(schemas(values)) {
            if known_schema(value_schema) {
                count += 1
            }
        }
        return count
    }
}

impl fn positional_schema_count<...Ts>(values: ...Ts) -> i64 {
    when {
        var count = 0
        for index, value_schema in items(schemas(values)) {
            if known_schema(value_schema) && (index == 0 || index == 1) {
                count += 1
            }
        }
        return count
    }
}

impl fn named_schema_count<...Fields>(values: ...{Fields}) -> i64 {
    when {
        var count = 0
        for name, value_schema in items(schemas(values)) {
            if known_schema(value_schema) && (name == "a" || name == "b") {
                count += 1
            }
        }
        return count
    }
}

instantiate positional_count<_>, named_count<_>, homogeneous_schema_count<_>, triggered_schema_count<_>, positional_schema_count<_>, named_schema_count<_>

export fn absolute_graph(value: f64) -> f64 => absolute(value)

export fn all_runtime_graph(a: bool, b: bool) -> bool => all_runtime(a, b)
export fn positional_count_graph(a: f64, b: str) -> i64 => positional_count(a, b)
export fn named_count_graph(a: f64, b: str) -> i64 => named_count(b: b, a: a)
export fn homogeneous_schema_count_graph(a: f64, b: f64) -> i64 => homogeneous_schema_count(a, b)
export fn triggered_schema_count_graph(trigger: f64, a: f64, b: f64) -> i64 => triggered_schema_count(trigger, a, b)
export fn positional_schema_count_graph(a: f64, b: str) -> i64 => positional_schema_count(a, b)
export fn named_schema_count_graph(a: f64, b: str) -> i64 => named_schema_count(b: b, a: a)

export fn absolute_local(value: f64) -> f64 {
    when modified(value) && valid(value) {
        var result: f64
        if value < 0.0 {
            result = -value
        } else {
            result = value
        }
        return result
    }
}

export fn add_when_ready(a: f64, b: f64) -> f64 {
    when modified(a, b) && valid(a, b) {
        return a + b
    }
}

export fn sample_on_trigger(trigger: f64, sample: f64) -> f64 {
    when modified(trigger) && valid(trigger, sample) {
        return sample
    }
}

export fn updated_at(value: f64) -> datetime {
    when modified(value) {
        return last_modified(value)
    }
}

export fn count_ticks(pulse: signal) -> i64 {
    state count: i64 = 0

    when modified(pulse) {
        count += 1
        return count
    }
}

export fn count_float_ticks(value: f64) -> i64 => count_ticks(value)
fn count_bool_ticks(value: bool) -> i64 => count_ticks(value)

export fn combined_total(a: f64, b: f64) -> f64 {
    state total: f64 = 0.0
    inject out

    when modified(a) && valid(a) {
        total += a
        out = total
    }

    when modified(b) && valid(b) {
        total -= b
        out = total
    }
}

export fn combined_total_graph(a: f64, b: f64) -> f64 =>
    combined_total(a, b)

export fn running_total(value: f64) -> f64 {
    inject out

    when modified(value) && valid(value) {
        if valid(out) {
            out += value
        } else {
            out = value
        }
    }
}

export fn mutate_set(step: i64) -> set<i64> {
    inject out

    when {
        if step == 1 {
            insert(out, 1)
            upsert(out, 1)
            upsert(out, 2)
            discard(out, 99)
        } else {
            remove(out, 1)
            upsert(out, 3)
        }
    }
}

export fn mutate_map(step: i64) -> map<str, i64> {
    inject out

    when {
        if step == 1 {
            insert(out, "a", 1)
            upsert(out, "b", 2)
            discard(out, "missing")
        } else if step == 2 {
            update(out, "a", 3)
            upsert(out, "b", 4)
            upsert(out, "c", 5)
            remove(out, "a")
        } else {
            invalidate(out, "b")
            clear(out)
        }
    }
}

export fn mutate_list(step: i64) -> list<i64, unbounded> {
    inject out

    when {
        if step == 1 {
            push(out, 1)
            push(out, 2)
        } else if step == 2 {
            pop(out)
            push(out, 3)
        } else {
            pop(out)
            invalidate(out, 0)
            clear(out)
        }
    }
}

# An explicit atomic boundary makes a complete collection snapshot stageable.
export fn mutate_atomic_map(value: atomic<set<i64>>) -> map<str, atomic<set<i64>>> {
    inject out

    when {
        upsert(out, "value", value)
    }
}

export fn lifecycle_value(value: f64) -> f64 {
    state ready: bool = false

    start {
        ready = true
    }

    when modified(value) && valid(value) {
        if ready {
            return value
        }
    }

    stop {
        ready = false
    }
}

export fn configured_total(value: f64, const initial: f64 = 10.0) -> f64 {
    state total = initial

    when modified(value) && valid(value) {
        total += value
        return total
    }
}

export fn configured_app(const value: f64 = 2.0, const initial: f64 = 5.0) -> f64 =>
    configured_total(value, initial)

export fn unconditional_total(value: f64) -> f64 {
    state total: f64 = 0.0
    total += value
    return total
}

fn private_total(value: f64) -> f64 {
    state total: f64 = 0.0

    when modified(value) && valid(value) {
        total += value
        return total
    }
}

export fn private_total_graph(value: f64) -> f64 => private_total(value)

test scripted_runtime_node {
    assert eval(add_when_ready, a: [1.0, _, 3.0], b: [_, 10.0, 20.0]) == [_, 11.0, 23.0]
}

test scripted_operator_impl {
    assert eval(absolute_graph, value: [-2.0, 3.0]) == [2.0, 3.0]
}

test scripted_variadic_operator_impl {
    assert eval(all_runtime_graph, a: [true, true], b: [false, true]) == [false, true]
    assert eval(positional_count_graph, a: [1.0], b: ["x"]) == [2]
    assert eval(named_count_graph, a: [1.0], b: ["x"]) == [2]
}

test scripted_private_runtime_node {
    assert eval(private_total_graph, value: [1.0, 2.0, 3.0]) == [1.0, 3.0, 6.0]
}

test scripted_signal_input {
    assert eval(count_bool_ticks, value: [true, false, true]) == [1, 2, 3]
    assert eval(count_float_ticks, value: [1.0, 2.0, 3.0]) == [1, 2, 3]
}

export fn cache_bundle(value: i64) -> f64 {
    cache count: i64 = 0
    cache total: f64 = 0.0
    when modified(value) && valid(value) {
        count += 1
        total += value
        return total / count
    }
}

export fn first_scalar(values: list<i64, 2>) -> i64 {
    when modified(values) && valid(values[0]) { return values[0] }
}

# These sources remain outside the endpoint/scheduler-only recovery contract.
export fn cached_source() -> i64 {
    cache count: i64 = 0
    inject scheduler
    start { schedule(scheduler, 0s) }
    when scheduled() {
        count += 1
        return count
    }
}

export fn clock_source() -> i64 {
    inject scheduler, clock
    start { schedule(scheduler, 0s) }
    when scheduled() { return 1 }
}

# ADR 0011 / ADR 0008: `state` is recordable and survives a restore; `cache` is
# rebuilt by every start. One function declaring both is the mixed case, and
# encoding both in the result makes the difference observable -- `total` keeps
# counting across a restore, `seen` starts again.
export fn mixed_total(value: i64) -> i64 {
    state total: i64 = 0
    cache seen: i64 = 0
    when modified(value) && valid(value) {
        total += value
        seen += 1
        return total * 10 + seen
    }
}

# Two of each, so the recordable TSB and the generated cache struct both carry
# more than one field and the storages cannot be told apart by arity.
export fn mixed_bundle(value: i64) -> i64 {
    state total: i64 = 0
    state seen: i64 = 0
    cache count: i64 = 0
    cache scale: i64 = 2
    start { count = 0 }
    when modified(value) && valid(value) {
        total += value
        seen += 1
        count += 1
        return (total + seen) * scale + count
    }
}

# An initializer may name an earlier declaration of the OTHER kind, so the
# initializers have to run in declaration order. Seeding every state before any
# cache read `seed` before it was written and silently used its default;
# rebuilding `echo` from restored state is the pairing ADR 0011 exists for.
export fn ordered_seed(value: i64) -> i64 {
    cache seed: i64 = 7
    state total: i64 = seed
    cache echo: i64 = total
    when modified(value) && valid(value) {
        total += value
        return total * 10 + echo
    }
}

test {
    # Wired through the scripted path, so direct wiring over the generated
    # artifact carries a node holding both storages at once.
    test mixed_state_and_cache {
        assert eval(mixed_total, value: [1, 2]) == [11, 32]
        assert eval(mixed_bundle, value: [1, 2]) == [5, 12]
        # seed 7 -> total 7 -> echo 7; had the order been states-first, total
        # would have taken the cache's default 0 and this would read 10, 30.
        assert eval(ordered_seed, value: [1, 2]) == [87, 107]
    }
}

# The library constant is spelled `const` (MIG-009): an operator named by a
# reserved word, emitted as a C++ struct under a mangled name, and called as
# `const(value)`; `const(f)` with a function name stays the ADR 0008 selector.
operator const<T>(const value: T, const delay: duration = 0s) -> T
impl fn const<T>(const value: T, const delay: duration = 0s) -> T {
    inject scheduler
    start { schedule(scheduler, delay) }
    when scheduled() { return value }
}
instantiate const<i64>, const<str>

operator const_sink(ts: signal)
impl fn const_sink(ts: signal) { when { } }

fn const_forty_two(tick: i64) -> i64 {
    const_sink(tick)
    const(42)
}
fn const_text(tick: i64) -> str {
    const_sink(tick)
    const("hgl", delay: 1us)
}
const fn const_scale(value: f64, factor: f64) -> f64 => value * factor
fn const_selected(value: f64) -> f64 { const(const_scale)(value, 3.0) }

test const_by_its_own_name {
    assert eval(const_forty_two, tick: [1, 1]) == [42, _]
    assert eval(const_text, tick: [1, 1]) == [_, "hgl"]
    assert eval(const_selected, value: [1.0, 2.0]) == [3.0, 6.0]
}

const fn ordinary_unbounded_literal() -> i64 {
    var values: list<i64> = [1, 2, 3]
    push(values, values[0])
    return values[3] + len(values)
}
const fn ordinary_fixed_literal() -> i64 {
    let values: list<i64, 2> = [4, 5]
    return values[0] + values[1]
}
export fn ordinary_literal_result(trigger: i64) -> i64 {
    when { return ordinary_unbounded_literal() + ordinary_fixed_literal() }
}
fn ordinary_bool_text(value: bool) -> str { when { return str(value) } }
fn ordinary_int_text(value: i64) -> str { when { return str(value) } }
fn ordinary_float_text(value: f64) -> str { when { return str(value) } }
fn ordinary_str_text(value: str) -> str { when { return str(value) } }
fn ordinary_date_text(value: date) -> str { when { return str(value) } }
fn ordinary_time_text(value: time) -> str { when { return str(value) } }
fn ordinary_datetime_text(value: datetime) -> str { when { return str(value) } }
fn ordinary_duration_text(value: duration) -> str { when { return str(value) } }
test ordinary_literals_and_scalar_text {
    assert eval(ordinary_owned_delta_result, trigger: [1, 1]) == [10, 11]
    assert eval(ordinary_nested_result, trigger: [1]) == [true]
    assert eval(ordinary_literal_result, trigger:[1]) == [14]
    assert eval(ordinary_bool_text, value:[true]) == ["True"]
    assert eval(ordinary_int_text, value:[12]) == ["12"]
    assert eval(ordinary_float_text, value:[1.5]) == ["1.5"]
    assert eval(ordinary_str_text, value:["unchanged"]) == ["unchanged"]
    assert eval(ordinary_date_text, value:[@2024-02-29]) == ["2024-02-29"]
    assert eval(ordinary_time_text, value:[@12:34:56]) == ["12:34:56"]
    assert eval(ordinary_datetime_text, value:[@2024-02-29T12:34:56Z]) == ["2024-02-29 12:34:56"]
    assert eval(ordinary_duration_text, value:[1s]) == ["0:00:01"]
}

const fn ordinary_nested_mutation() -> bool {
    var child: list<i64> = [1]
    var outer: list<list<i64>> = [child]
    push(outer, outer[0])
    push(outer[0], 2)
    return len(outer) == 2 && len(outer[0]) == 2 && outer[0][1] == 2 && len(outer[1]) == 1 && outer[1][0] == 1
}
export fn ordinary_nested_result(trigger: i64) -> bool {
    when { return ordinary_nested_mutation() }
}

fn ordinary_owned_delta_source() -> map<i64, i64> {
    yield 0s: delta<map<i64, i64>>(upsert: [1: 10])
    yield 1us: delta<map<i64, i64>>(upsert: [1: 11])
}

export fn ordinary_owned_delta_result(trigger: i64) -> i64 {
    const_sink(trigger)
    ordinary_owned_delta_source()[1]
}

export fn ordinary_configured_lengths(trigger: i64, const values: list<i64>) -> i64 {
    when {
        var independent = values
        push(independent, values[0])
        return len(values) * 10 + len(independent)
    }
}

fn generic_branch_copy<T>(value: T) -> T => value
export fn generic_then_conditional(condition: bool, value: i64) -> i64 {
    let retained = generic_branch_copy(value)
    if condition { retained } else { value }
}

fn generic_signal_count<T>(value: T) -> i64 => count_ticks(value)
export fn generic_scalar_signal_count(value: i64) -> i64 => generic_signal_count(value)
export fn generic_structural_signal_count(value: list<i64, 2>) -> i64 => generic_signal_count(value)

enum RuntimeMode { first = -7, second = 11, low = -9223372036854775808, high = 9223372036854775807 }
fn enum_generic_forward<T>(value: T) -> T {
    when { return delta_value(value) }
}
export fn enum_forward(value: RuntimeMode) -> RuntimeMode => enum_generic_forward(value)
export fn enum_fixed_forward(value: list<RuntimeMode, 2>) -> list<RuntimeMode, 2> => enum_generic_forward(value)
export fn enum_default_source(trigger: i64) -> RuntimeMode {
    when { return RuntimeMode::first }
}

export fn enum_value_forward(value: RuntimeMode) -> RuntimeMode {
    when { return value }
}

export fn scalar_float_set(value: set<f64>) -> set<f64> => enum_generic_forward(value)
export fn scalar_float_map(value: map<f64, i64>) -> map<f64, i64> => enum_generic_forward(value)

export fn scalar_string_recipe(trigger: i64) -> map<str, i64> {
    when { return delta<map<str, i64>>(upsert: ["second": 2, "first": 1]) }
}

export fn atomic_map_recipe(key: str, value: i64) -> atomic<map<str, list<i64>>> {
    when {
        var row: list<i64> = []
        push(row, value)
        let saved = map<str, list<i64>>(items: [key: row])
        push(row, 999)
        return saved
    }
}
export fn atomic_set_recipe(first: str, second: str) -> atomic<set<str>> {
    when { return set<str>(items: [first, second]) }
}
struct DefaultChild { amount: i64 = 7
    values: list<i64> = [] }
struct DefaultParent { children: map<str, DefaultChild> = map<str, DefaultChild>(items: ["x": DefaultChild(amount: 42)]) }
export fn atomic_struct_map_default(trigger: i64) -> atomic<DefaultParent> {
    when { return DefaultParent() }
}
struct RuntimeCollections { values: map<str, list<i64>> = map<str, list<i64>>(items: ["empty": []]) }
export fn atomic_collection_default(trigger: i64) -> atomic<RuntimeCollections> {
    when {
        var source = RuntimeCollections()
        let retained = source
        source.values = map<str, list<i64>>(items: [])
        return retained
    }
}

const fn prepared_zone_key_recipe() -> delta<map<timezone, timezone>> {
    let original: timezone = @[UTC]
    let alias: timezone = original
    let retained: timezone = alias
    return delta<map<timezone, timezone>>(upsert: [alias: retained])
}
export fn prepared_zone_key_forward(value: map<timezone, timezone>) -> map<timezone, timezone> => enum_generic_forward(value)

export fn growing_forward(value: list<i64>) -> list<i64> => enum_generic_forward(value)
export fn growing_source() -> list<i64> {
    yield 0s: delta<list<i64>>(items: [0: 1, 1: 2])
    yield 1us: delta<list<i64>>(items: [0: 1], remove: [1])
    yield 1us: delta<list<i64>>(remove: [0])
    yield 1us: delta<list<i64>>(items: [0: 3])
}

export fn rolling_concrete_return(value: rolling<i64, 2, 2>) -> rolling<i64, 2, 2> {
    when { return delta_value(value) }
}
export fn rolling_concrete_assign(value: rolling<i64, 5us, 1us>) -> rolling<i64, 5us, 1us> {
    inject out
    when { out = delta_value(value) }
}
export fn rolling_concrete_list(value: rolling<list<i64>, 2>) -> rolling<list<i64>, 2> {
    inject out
    when { out = delta_value(value) }
}
export fn rolling_concrete_source() -> rolling<i64, 2> {
    yield 0s: 10
    yield 1us: 10
    yield 1us: 20
}

export fn rolling_ticks_forward(value: rolling<i64, 2, 2>) -> rolling<i64, 2, 2> => enum_generic_forward(value)
export fn rolling_duration_forward(value: rolling<i64, 5us, 1us>) -> rolling<i64, 5us, 1us> => enum_generic_forward(value)
export fn rolling_ticks_ready(value: rolling<i64, 2, 2>) -> bool {
    when valid(value) && modified(value) { return all_valid(value) }
}
export fn rolling_duration_ready(value: rolling<i64, 5us, 1us>) -> bool {
    when valid(value) && modified(value) { return all_valid(value) }
}
export fn rolling_observed_ticks(value: rolling<i64, 2, 2>) -> bool => rolling_ticks_ready(rolling_ticks_forward(value))
export fn rolling_observed_duration(value: rolling<i64, 5us, 1us>) -> bool => rolling_duration_ready(rolling_duration_forward(value))

struct NativeOptionalPublication { count: i64 = null
    items: list<i64> = null }
export fn optional_publication_source(trigger: i64) -> atomic<NativeOptionalPublication> {
    when {
        if trigger == 1 { return NativeOptionalPublication(count: 0, items: []) }
        return NativeOptionalPublication()
    }
}
export fn optional_publication_forward(value: atomic<NativeOptionalPublication>) -> atomic<NativeOptionalPublication> => enum_generic_forward(value)

abstract struct NativePublicationFamily { label: str }
struct NativePublicationFirst: NativePublicationFamily { items: list<i64>
    count: i64 = null }
struct NativePublicationSecond: NativePublicationFamily { items: list<i64>
    count: i64 = null }
export fn native_family_forward(value: atomic<NativePublicationFamily>) -> atomic<NativePublicationFamily> => enum_generic_forward(value)
export fn native_family_source(value: i64) -> atomic<NativePublicationFamily> {
    when {
        if value == 1 { return NativePublicationFirst(label: "same", items: [1]) }
        return NativePublicationSecond(label: "same", items: [1], count: 0)
    }
}
const fn native_family_capture() -> NativePublicationFamily {
    let member: NativePublicationFamily = NativePublicationFirst(label: "cold", items: [])
    return member
}

struct NativeCompositeKey { number: i64
    label: str
    flag: bool = null }
export fn native_composite_key_forward(value: map<NativeCompositeKey, i64>) -> map<NativeCompositeKey, i64> => enum_generic_forward(value)
const fn native_composite_key_recipe() -> delta<map<NativeCompositeKey, i64>> {
    let key = NativeCompositeKey(number: 1, label: "one")
    return delta<map<NativeCompositeKey, i64>>(upsert: [key: 7, NativeCompositeKey(number: 1, label: "one", flag: false): 8])
}
struct NativeZoneKey { zone: timezone
    number: i64 }
const fn native_zone_key_recipe() -> delta<set<NativeZoneKey>> {
    let key = NativeZoneKey(zone: @[US/Eastern], number: 1)
    let alias = key
    return delta<set<NativeZoneKey>>(added: [alias])
}

abstract struct NativeUnusedFamily { label: str }
struct NativeUnusedMember: NativeUnusedFamily { number: i64 }
export fn native_unused_forward(value: atomic<NativeUnusedFamily>) -> atomic<NativeUnusedFamily> => enum_generic_forward(value)

abstract struct NativeLateFamily { label: str }
const fn native_late_capture(value: NativeLateFamily) -> NativeLateFamily => value
export fn native_late_forward(value: atomic<NativeLateFamily>) -> atomic<NativeLateFamily> { when { return delta_value(value) } }

abstract struct NativePublicationMiddle: NativePublicationFamily {}
struct NativePublicationLeaf: NativePublicationMiddle { items: list<i64> }
const fn native_subfamily_capture() -> NativePublicationFamily {
    var child = NativePublicationLeaf(label: "nested", items: [1])
    let middle: NativePublicationMiddle = child
    let ancestor: NativePublicationFamily = middle
    push(child.items, 2)
    return ancestor
}

# Concrete and inherited nominal records retain their ordinary origin.
struct NominalObservedRecord { pair: tuple<i64, bool>
                extra: i64 = null }
abstract struct NominalObservedParent { id: i64 }
struct NominalObservedChild: NominalObservedParent { pair: tuple<i64, bool>
                      extra: i64 = null }
struct NominalObservedGenericRecord<T> { pair: tuple<T, bool> }
export fn nominal_construct(value: i64) -> NominalObservedRecord {
    when { return NominalObservedRecord(pair: (value, false)) }
}
export fn nominal_copied(value: NominalObservedRecord) -> NominalObservedRecord {
    when valid(value) && valid(value.pair) && valid(value.pair[0]) {
        let copy = value
        return copy
    }
}
export fn nominal_read(value: NominalObservedRecord) -> bool {
    when valid(value) && all_valid(value.pair) {
        let copy = value
        return copy.pair[1]
    }
}
export fn nominal_child_copied(value: NominalObservedChild) -> NominalObservedChild {
    when valid(value) && valid(value.id) {
        let copy = value
        return copy
    }
}
export fn nominal_generic_copied<T>(value: NominalObservedGenericRecord<T>) -> NominalObservedGenericRecord<T> {
    when all_valid(value) {
        let copy = value
        return copy
    }
}
export fn nominal_generic_int(value: NominalObservedGenericRecord<i64>) -> NominalObservedGenericRecord<i64> => nominal_generic_copied(value)
export fn nominal_tuple_read(value: tuple<NominalObservedRecord, bool>) -> bool {
    when valid(value) && valid(value[0]) && all_valid(value[0].pair) {
        let copy = value
        return copy[0].pair[1]
    }
}
export fn nominal_list_read(value: list<NominalObservedRecord, 2>) -> bool {
    when valid(value) && valid(at(value, 0)) && all_valid(at(value, 0).pair) {
        let copy = value
        return copy[0].pair[1]
    }
}
export fn nominal_map_read(value: map<i64, NominalObservedRecord>) -> bool {
    when valid(value) && valid(at(value, 4)) && all_valid(at(value, 4).pair) {
        let copy = value
        return copy[4].pair[1]
    }
}
test named_record_constructor_and_sparse_observation {
    let partial = delta<NominalObservedRecord>(pair: delta<tuple<i64, bool>>(items: [0: 7]))
    let tick = delta<NominalObservedRecord>(pair: delta<tuple<i64, bool>>(items: [1: false]))
    let complete = delta<NominalObservedRecord>(pair: delta<tuple<i64, bool>>(items: [0: 7, 1: false]))
    assert eval(nominal_construct, [7, _, 7]) == [complete, _, complete]
    assert eval(nominal_copied, [partial, tick]) == [partial, complete]
    assert eval(nominal_read, [complete]) == [false]
    let child = delta<NominalObservedChild>(id: 4, pair: delta<tuple<i64, bool>>(items: [0: 7]))
    let child_tick = delta<NominalObservedChild>(pair: delta<tuple<i64, bool>>(items: [1: false]))
    let child_complete = delta<NominalObservedChild>(id: 4, pair: delta<tuple<i64, bool>>(items: [0: 7, 1: false]))
    assert eval(nominal_child_copied, [child, child_tick]) == [child, child_complete]
    assert eval(nominal_generic_int, [delta<NominalObservedGenericRecord<i64>>(pair: delta<tuple<i64, bool>>(items: [0: 7, 1: false]))]) == [delta<NominalObservedGenericRecord<i64>>(pair: delta<tuple<i64, bool>>(items: [0: 7, 1: false]))]
}
test named_record_in_supported_composites {
    let record = delta<NominalObservedRecord>(pair: delta<tuple<i64, bool>>(items: [0: 7, 1: false]))
    assert eval(nominal_tuple_read, [delta<tuple<NominalObservedRecord, bool>>(items: [0: record, 1: true])]) == [false]
    assert eval(nominal_list_read, [delta<list<NominalObservedRecord, 2>>(items: [0: record])]) == [false]
    assert eval(nominal_map_read, [delta<map<i64, NominalObservedRecord>>(upsert: [4: record])]) == [false]
}

export fn generic_tuple<T>(value: T) -> tuple<T, bool> {
    when { return (value, false) }
}
export fn generic_tuple_int_wrapper(value: i64) -> tuple<i64, bool> => generic_tuple(value)
test generic_tuple_runtime_field {
    assert eval(generic_tuple_int_wrapper, [7, 8]) == [(7, false), (8, false)]
}

# Complete ordinary publications reconcile observations; deltas stay sparse.
struct NominalPublicationPair {
    left: i64
    right: bool
}


export fn publication_select_value(step: i64, a: NominalPublicationPair, b: NominalPublicationPair) -> NominalPublicationPair {
    when modified(step) && valid(step) && valid(a) && valid(b) {
        if step == 1 {
            let copy = a
            return copy
        } else {
            let copy = b
            return copy
        }
    }
}

export fn publication_select_delta(step: i64, a: NominalPublicationPair, b: NominalPublicationPair) -> NominalPublicationPair {
    when modified(step) && valid(step) && valid(a) && valid(b) {
        if step == 1 {
            if modified(a) { return delta_value(a) }
        } else {
            if modified(b) { return delta_value(b) }
        }
    }
}

export fn publication_pair_validity(step: i64, watched: NominalPublicationPair) -> bool {
    when modified(step) && valid(step) { return all_valid(watched) }
}
export fn publication_value_validity(step: i64, a: NominalPublicationPair, b: NominalPublicationPair) -> bool =>
    publication_pair_validity(step, publication_select_value(step, a, b))
export fn publication_delta_validity(step: i64, a: NominalPublicationPair, b: NominalPublicationPair) -> bool =>
    publication_pair_validity(step, publication_select_delta(step, a, b))

test complete_value_and_delta_have_distinct_child_validity {
    let full = delta<NominalPublicationPair>(left: 1, right: true)
    let partial = delta<NominalPublicationPair>(left: 2)
    # B is independently partial; it never held A's right-hand value.
    assert eval(publication_value_validity, step: [1, 2, 3], a: [full, _, _], b: [partial, partial, _]) == [true, false, false]
    assert eval(publication_delta_validity, step: [1, 2, 3], a: [full, _, _], b: [partial, partial, _]) == [true, true, true]
}

export fn publication_removing_map(step: i64) -> map<i64, i64> {
    inject out
    when {
        if step == 1 {
            upsert(out, 7, 10)
            upsert(out, 8, 20)
        } else if step == 2 { remove(out, 8) }
    }
}
export fn publication_invalidating_map(step: i64) -> map<i64, i64> {
    inject out
    when {
        if step == 1 {
            upsert(out, 7, 10)
            upsert(out, 8, 20)
        } else if step == 2 { invalidate(out, 8) }
    }
}
export fn publication_copy_map(step: i64, value: map<i64, i64>) -> map<i64, i64> {
    when modified(step) && valid(step) && valid(value) {
        let copy = value
        return copy
    }
}
export fn publication_delta_map(value: map<i64, i64>) -> map<i64, i64> {
    when { return delta_value(value) }
}
export fn publication_has_second(step: i64, watched: map<i64, i64>) -> bool {
    when modified(step) && valid(step) && valid(watched) { return contains(watched, 8) }
}
export fn publication_map_validity(step: i64, watched: map<i64, i64>) -> bool {
    when modified(step) && valid(step) { return all_valid(watched) }
}
export fn publication_copied_membership(step: i64) -> bool => publication_has_second(step, publication_copy_map(step, publication_removing_map(step)))
export fn publication_delta_membership(step: i64) -> bool => publication_has_second(step, publication_delta_map(publication_removing_map(step)))
export fn publication_copied_invalid_membership(step: i64) -> bool => publication_has_second(step, publication_copy_map(step, publication_invalidating_map(step)))
export fn publication_copied_map_validity(step: i64) -> bool => publication_map_validity(step, publication_copy_map(step, publication_invalidating_map(step)))

# Child invalidation is observed through the complete value; no empty delta
# application or new invalid member is required by these cases.
test complete_map_copy_reconciles_membership_and_child_validity {
    assert eval(publication_copied_membership, step: [1, 2, 3]) == [true, false, false]
    assert eval(publication_delta_membership, step: [1, 2, 3]) == [true, false, false]
    assert eval(publication_copied_invalid_membership, step: [1, 2, 3]) == [true, true, true]
    assert eval(publication_copied_map_validity, step: [1, 2, 3]) == [true, false, false]
}

export fn publication_select_tuple(step: i64, a: tuple<i64, bool>, b: tuple<i64, bool>) -> tuple<i64, bool> {
    when modified(step) && valid(step) && valid(a) && valid(b) {
        if step == 1 {
            let copy = a
            return copy
        } else {
            let copy = b
            return copy
        }
    }
}
export fn publication_tuple_validity(step: i64, watched: tuple<i64, bool>) -> bool {
    when modified(step) && valid(step) { return all_valid(watched) }
}
export fn publication_tuple_result_validity(step: i64, a: tuple<i64, bool>, b: tuple<i64, bool>) -> bool =>
    publication_tuple_validity(step, publication_select_tuple(step, a, b))

test complete_tuple_copy_clears_a_previously_valid_child {
    # Separate B has no right child; sparse updates to A cannot create this state.
    assert eval(publication_tuple_result_validity, step: [1, 2, 3], a: [(1, true), _, _], b: [(2, _), (2, _), _]) == [true, false, false]
}

export fn publication_select_list(step: i64, a: list<i64, 2>, b: list<i64, 2>) -> list<i64, 2> {
    when modified(step) && valid(step) && valid(a) && valid(b) {
        if step == 1 {
            let copy = a
            return copy
        } else {
            let copy = b
            return copy
        }
    }
}
export fn publication_list_validity(step: i64, watched: list<i64, 2>) -> bool {
    when modified(step) && valid(step) { return all_valid(watched) }
}
export fn publication_list_result_validity(step: i64, a: list<i64, 2>, b: list<i64, 2>) -> bool =>
    publication_list_validity(step, publication_select_list(step, a, b))

test complete_fixed_list_copy_clears_a_previously_valid_child {
    let full = delta<list<i64, 2>>(items: [0: 1, 1: 10])
    let partial = delta<list<i64, 2>>(items: [0: 2])
    assert eval(publication_list_result_validity, step: [1, 2, 3], a: [full, _, _], b: [partial, partial, _]) == [true, false, false]
}

export fn publication_generic_select<T>(step: i64, a: T, b: T) -> T {
    when modified(step) && valid(step) && valid(a) && valid(b) {
        if step == 1 {
            let copy = a
            return copy
        } else {
            let copy = b
            return copy
        }
    }
}
export fn publication_generic_tuple_validity(step: i64, a: tuple<i64, bool>, b: tuple<i64, bool>) -> bool =>
    publication_tuple_validity(step, publication_generic_select(step, a, b))
export fn publication_generic_list_validity(step: i64, a: list<i64, 2>, b: list<i64, 2>) -> bool =>
    publication_list_validity(step, publication_generic_select(step, a, b))
export fn publication_generic_pair_validity(step: i64, a: NominalPublicationPair, b: NominalPublicationPair) -> bool =>
    publication_pair_validity(step, publication_generic_select(step, a, b))
export fn publication_generic_map_copy<T>(step: i64, value: T) -> T {
    when modified(step) && valid(step) && valid(value) {
        let copy = value
        return copy
    }
}
export fn publication_generic_map_membership(step: i64) -> bool =>
    publication_has_second(step, publication_generic_map_copy(step, publication_removing_map(step)))
export fn publication_generic_map_validity(step: i64) -> bool =>
    publication_map_validity(step, publication_generic_map_copy(step, publication_invalidating_map(step)))
export fn publication_nested_validity(step: i64, watched: tuple<tuple<i64, bool>, bool>) -> bool {
    when modified(step) && valid(step) { return all_valid(watched) && all_valid(watched[0]) }
}
export fn publication_generic_nested_validity(step: i64, a: tuple<tuple<i64, bool>, bool>, b: tuple<tuple<i64, bool>, bool>) -> bool =>
    publication_nested_validity(step, publication_generic_select(step, a, b))
test generic_complete_values_preserve_recursive_observations {
    assert eval(publication_generic_tuple_validity, step: [1, 2, 3], a: [(1, false), _, _], b: [(2, _), (2, _), _]) == [true, false, false]
    let full_list = delta<list<i64, 2>>(items: [0: 1, 1: 10])
    let partial_list = delta<list<i64, 2>>(items: [0: 2])
    assert eval(publication_generic_list_validity, step: [1, 2, 3], a: [full_list, _, _], b: [partial_list, partial_list, _]) == [true, false, false]
    let full_pair = delta<NominalPublicationPair>(left: 1, right: false)
    let partial_pair = delta<NominalPublicationPair>(left: 2)
    assert eval(publication_generic_pair_validity, step: [1, 2, 3], a: [full_pair, _, _], b: [partial_pair, partial_pair, _]) == [true, false, false]
    assert eval(publication_generic_map_membership, step: [1, 2, 3]) == [true, false, false]
    assert eval(publication_generic_map_validity, step: [1, 2, 3]) == [true, false, false]
    assert eval(publication_generic_nested_validity, step: [1, 2, 3], a: [((1, false), false), _, _], b: [((2, _), false), ((2, _), false), _]) == [true, false, false]
}

export fn generic_tuple_record(value: NominalObservedGenericRecord<tuple<i64, bool>>) -> NominalObservedGenericRecord<tuple<i64, bool>> => nominal_generic_copied(value)
test generic_record_with_structural_argument {
    let inner = delta<tuple<i64, bool>>(items: [0: 7, 1: false])
    let pair = delta<tuple<tuple<i64, bool>, bool>>(items: [0: inner, 1: false])
    let record = delta<NominalObservedGenericRecord<tuple<i64, bool>>>(pair: pair)
    assert eval(generic_tuple_record, [record]) == [record]
}

export fn generic_list_record(value: NominalObservedGenericRecord<list<tuple<i64, bool>, 2>>) -> NominalObservedGenericRecord<list<tuple<i64, bool>, 2>> => nominal_generic_copied(value)
export fn generic_map_record(value: NominalObservedGenericRecord<map<i64, tuple<i64, bool>>>) -> NominalObservedGenericRecord<map<i64, tuple<i64, bool>>> => nominal_generic_copied(value)
export fn generic_nominal_record(value: NominalObservedGenericRecord<NominalObservedRecord>) -> NominalObservedGenericRecord<NominalObservedRecord> => nominal_generic_copied(value)
struct NominalGenericAtomicRecord<T> {
    plain: T
    opaque: atomic<T>
}
export fn atomic_copied<T>(value: NominalGenericAtomicRecord<T>) -> NominalGenericAtomicRecord<T> {
    when all_valid(value) { let copy = value
        return copy }
}
export fn atomic_tuple_record(value: NominalGenericAtomicRecord<tuple<i64, bool>>) -> NominalGenericAtomicRecord<tuple<i64, bool>> => atomic_copied(value)
test generic_record_composite_closure_and_atomic_boundary {
    let partial_pair = delta<tuple<i64, bool>>(items: [0: 7])
    let list_value = delta<list<tuple<i64, bool>, 2>>(items: [0: partial_pair])
    let listed = delta<NominalObservedGenericRecord<list<tuple<i64, bool>, 2>>>(pair: delta<tuple<list<tuple<i64, bool>, 2>, bool>>(items: [0: list_value, 1: false]))
    assert eval(generic_list_record, [listed]) == [listed]
    let map_value = delta<map<i64, tuple<i64, bool>>>(upsert: [4: partial_pair])
    let mapped = delta<NominalObservedGenericRecord<map<i64, tuple<i64, bool>>>>(pair: delta<tuple<map<i64, tuple<i64, bool>>, bool>>(items: [0: map_value, 1: false]))
    assert eval(generic_map_record, [mapped]) == [mapped]
    let record_value = delta<NominalObservedRecord>(pair: partial_pair)
    let named = delta<NominalObservedGenericRecord<NominalObservedRecord>>(pair: delta<tuple<NominalObservedRecord, bool>>(items: [0: record_value, 1: false]))
    assert eval(generic_nominal_record, [named]) == [named]
    let atomic_record = delta<NominalGenericAtomicRecord<tuple<i64, bool>>>(plain: partial_pair, opaque: (7, false))
    assert eval(atomic_tuple_record, [atomic_record]) == [atomic_record]
}

const fn scalar_helper_list_size(value: i64) -> i64 {
    var items: list<i64> = []
    push(items, value)
    return len(items)
}
export fn scalar_tuple_local(value: i64) -> i64 {
    when { let pair = (value, false)
        return pair[0] }
}
export fn scalar_list_local(value: i64) -> i64 {
    when { var items: list<i64> = []
        push(items, value)
        return len(items) }
}
export fn scalar_list_helper(value: i64) -> i64 {
    when { return scalar_helper_list_size(value) }
}
test scalar_signatures_prepare_aggregate_locals_and_helpers {
    assert eval(scalar_tuple_local, [7, 8]) == [7, 8]
    assert eval(scalar_list_local, [7, 8]) == [1, 1]
    assert eval(scalar_list_helper, [7, 8]) == [1, 1]
}

const fn specialized_pair_helper<T>(value: T) -> tuple<T, bool> => (value, false)
export fn specialized_int_helper_node(value: i64) -> tuple<i64, bool> {
    when { return specialized_pair_helper(value) }
}
export fn specialized_float_helper_node(value: f64) -> tuple<f64, bool> {
    when { return specialized_pair_helper(value) }
}
fn specialized_pair_check(integer: tuple<i64, bool>, floating: tuple<f64, bool>) -> bool {
    when valid(integer[0]) && valid(integer[1]) && valid(floating[0]) && valid(floating[1]) {
        return !integer[1] && !floating[1] && ((integer[0] == 7 && floating[0] == 1.5) || (integer[0] == 8 && floating[0] == 2.5))
    }
}
export fn specialized_helpers_together(integer: i64, floating: f64) -> bool =>
    specialized_pair_check(specialized_int_helper_node(integer), specialized_float_helper_node(floating))
test aggregate_helpers_keep_concrete_specializations_independent {
    assert eval(specialized_helpers_together, integer: [7, 8], floating: [1.5, 2.5]) == [true, true]
    assert eval(specialized_int_helper_node, [9]) == [(9, false)]
    assert eval(specialized_float_helper_node, [3.5]) == [(3.5, false)]
}


struct UnsetObservedNumber {
    sibling: i64
    child: i64
}
struct UnsetObservedFlag {
    sibling: i64
    child: bool
}
struct UnsetObservedSamples {
    sibling: i64
    child: list<i64, 2>
}

export fn unset_number(value: UnsetObservedNumber) -> i64 {
    when {
        let copy = value
        let child = copy.child
        return child + 1
    }
}
export fn unset_flag(value: UnsetObservedFlag) -> i64 {
    when {
        let copy = value
        let child = copy.child
        if child { return 1 } else { return 0 }
    }
}
export fn unset_length(value: UnsetObservedSamples) -> i64 {
    when {
        let copy = value
        return len(copy.child)
    }
}
export fn unset_native_text(value: UnsetObservedNumber) -> str {
    when {
        let copy = value
        let child = copy.child
        return str(child)
    }
}
export fn unset_retain_partial(value: tuple<i64, bool>) -> tuple<i64, bool> {
    when {
        let copy = value
        let child = copy[1]
        return (copy[0], child)
    }
}

test required_unset_payload_errors {
    assert raises("value.unset_read") {
        eval(unset_mutable_push, value: [delta<UnsetGrowingSamples>(sibling: 1)])
    }
    assert raises("value.unset_read") {
        eval(unset_mutable_length, value: [delta<UnsetObservedSamples>(sibling: 1)])
    }
    assert raises("value.unset_read") {
        eval(unset_list_index, value: [delta<UnsetObservedSamples>(sibling: 1)])
    }
    assert raises("value.unset_read") {
        eval(unset_map_index, value: [delta<UnsetObservedMapping>(sibling: 1)])
    }
    assert raises("value.unset_read") {
        eval(unset_native_text, value: [delta<UnsetObservedNumber>(sibling: 1)])
    }
    assert raises("value.unset_read") {
        eval(unset_number, value: [delta<UnsetObservedNumber>(sibling: 1)])
    }
    assert raises("value.unset_read") {
        eval(unset_flag, value: [delta<UnsetObservedFlag>(sibling: 1)])
    }
    assert raises("value.unset_read") {
        eval(unset_length, value: [delta<UnsetObservedSamples>(sibling: 1)])
    }
    assert true
}

test required_unset_present_payloads_and_retention {
    assert eval(unset_mutable_push, value: [delta<UnsetGrowingSamples>(sibling: 1, child: delta<list<i64>>(items: [0: 4]))]) == [2]
    assert eval(unset_abstract_known, value: [delta<UnsetAbstractOuter>(sibling: 1)]) == [1]
    assert eval(unset_abstract_present, sibling: [1], inner: [UnsetAbstractConcrete(number: 0)]) == [1]
    assert eval(unset_known_chain, value: [delta<UnsetKnownOuter>(sibling: 1)]) == [1]
    assert eval(unset_known_staged, value: [delta<UnsetKnownOuter>(sibling: 1)]) == [1]
    assert eval(unset_known_chain, value: [delta<UnsetKnownOuter>(sibling: 1, inner: delta<UnsetKnownInner>(nested: delta<UnsetKnownNested>(number: 0)))]) == [1]
    assert eval(unset_mutable_present, value: [delta<UnsetMutableOuter>(sibling: 1, inner: delta<UnsetMutableInner>(items: delta<list<i64>>(items: [0: 4])))]) == [(2, 1)]
    assert eval(unset_list_index, value: [delta<UnsetObservedSamples>(sibling: 1, child: delta<list<i64, 2>>(items: [0: 4, 1: 5]))]) == [5]
    assert eval(unset_map_index, value: [delta<UnsetObservedMapping>(sibling: 1, child: delta<map<i64, i64>>(upsert: [1: 4]))]) == [5]
    assert eval(unset_native_text, value: [delta<UnsetObservedNumber>(sibling: 1, child: 0)]) == ["0"]
    assert eval(unset_number, value: [delta<UnsetObservedNumber>(sibling: 1, child: 0)]) == [1]
    assert eval(unset_flag, value: [delta<UnsetObservedFlag>(sibling: 1, child: false), delta<UnsetObservedFlag>(child: true)]) == [0, 1]
    assert eval(unset_length, value: [delta<UnsetObservedSamples>(sibling: 1, child: delta<list<i64, 2>>(items: [0: 4, 1: 5]))]) == [2]
    assert eval(unset_retain_partial, value: [(1, _)]) == [(1, _)]
    assert eval(unset_retain_partial, value: [(1, false)]) == [(1, false)]
}

export fn unset_rebuild_number(value: UnsetObservedNumber) -> UnsetObservedNumber {
    when {
        let copy = value
        let child = copy.child
        return UnsetObservedNumber(sibling: copy.sibling, child: child)
    }
}

export fn unset_error_cleanup(value: UnsetObservedNumber) -> i64 {
    inject logger
    when {
        let copy = value
        let child = copy.child
        info(logger, "before")
        let first = child + 1
        info(logger, "unreachable")
        return first
    }
    stop { info(logger, "stopped") }
}

struct UnsetGeneratorNumber {
    sibling: i64
    child: i64 = null
}
export fn unset_generator_retention() -> i64 {
    inject logger
    let copy = UnsetGeneratorNumber(sibling: 1)
    let child = copy.child
    let alias = child
    info(logger, "retained")
    yield 1us: 1
    info(logger, "resumed")
    yield 1us: alias + 1
}

export fn unset_generator_present() -> i64 {
    let copy = UnsetGeneratorNumber(sibling: 1, child: 0)
    let child = copy.child
    let alias = child
    yield 1us: 1
    yield 1us: alias + 1
}

export fn unset_global_field(value: i64) -> i64 {
    inject global_state
    start { set(global_state, "unset-required-read-global", UnsetGeneratorNumber(sibling: 1)) }
    when {
        let borrowed: UnsetGeneratorNumber = get(global_state, "unset-required-read-global")
        return borrowed.child
    }
}

export fn unset_temporal_delta(value: UnsetObservedNumber) -> i64 {
    when valid(value.child) && modified(value.child) { return delta_value(value.child) }
}

export fn unset_list_index(value: UnsetObservedSamples) -> i64 {
    when {
        let copy = value
        let child = copy.child
        return child[0] + 1
    }
}
struct UnsetObservedMapping {
    sibling: i64
    child: map<i64, i64>
}
export fn unset_map_index(value: UnsetObservedMapping) -> i64 {
    when {
        let copy = value
        let child = copy.child
        return child[1] + 1
    }
}

struct UnsetKnownNested { number: i64 }
struct UnsetKnownInner { nested: UnsetKnownNested }
struct UnsetKnownOuter { sibling: i64
    inner: UnsetKnownInner }
export fn unset_known_chain(value: UnsetKnownOuter) -> i64 {
    when {
        let copy = value
        let child = copy.inner.nested.number
        let alias = child
        let pair = (copy.sibling, alias)
        return pair[0]
    }
}
export fn unset_known_staged(value: UnsetKnownOuter) -> i64 {
    when {
        let copy = value
        let inner = copy.inner
        let nested = inner.nested
        let child = nested.number
        let alias = child
        let pair = (copy.sibling, alias)
        return pair[0]
    }
}
export fn unset_mutable_length(value: UnsetObservedSamples) -> i64 {
    when {
        var copy = value
        return len(copy.child)
    }
}
struct UnsetMutableInner { items: list<i64> }
struct UnsetMutableOuter { sibling: i64
    inner: UnsetMutableInner }
export fn unset_mutable_present(value: UnsetMutableOuter) -> tuple<i64, i64> {
    when valid(value) && valid(value.inner) && valid(value.inner.items) {
        let original = value
        var copy = value
        push(copy.inner.items, 9)
        return (len(copy.inner.items), len(original.inner.items))
    }
}

abstract struct UnsetAbstractInner { number: i64 }
struct UnsetAbstractConcrete: UnsetAbstractInner {}
struct UnsetAbstractOuter { sibling: i64
    inner: atomic<UnsetAbstractInner> }
export fn unset_abstract_known(value: UnsetAbstractOuter) -> i64 {
    when {
        let copy = value
        let child = copy.inner.number
        let pair = (copy.sibling, child)
        return pair[0]
    }
}
export fn unset_abstract_present(sibling: i64, inner: atomic<UnsetAbstractConcrete>) -> i64 {
    return unset_abstract_known(UnsetAbstractOuter(sibling: sibling, inner: inner))
}

struct UnsetGrowingSamples { sibling: i64
    child: list<i64> }
export fn unset_mutable_push(value: UnsetGrowingSamples) -> i64 {
    when {
        var copy = value
        push(copy.child, 1)
        return len(copy.child)
    }
}
