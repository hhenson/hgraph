module checks.system_operators

use hgraph.std as core

// Local functions cannot redirect the fixed meaning of a symbol.
fn add_(lhs: i64, rhs: i64) -> i64 => lhs - rhs
export fn plus(lhs: i64, rhs: i64) -> i64 => lhs + rhs
export fn ratio(lhs: i64, rhs: i64) -> f64 => lhs / rhs
export fn remainder(lhs: i64, rhs: i64) -> i64 => lhs % rhs
export fn remainder_float(lhs: f64, rhs: f64) -> f64 => lhs % rhs
export fn floor_ratio(lhs: i64, rhs: i64) -> i64 => core::floordiv_(lhs, rhs)

export fn ratio_node(lhs: i64, rhs: i64) -> f64 {
    when modified(lhs) || modified(rhs) { return lhs / rhs }
}
export fn remainder_node(lhs: i64, rhs: i64) -> i64 {
    when modified(lhs) || modified(rhs) { return lhs % rhs }
}
export fn remainder_float_node(lhs: f64, rhs: f64) -> f64 {
    when modified(lhs) || modified(rhs) { return lhs % rhs }
}

test numeric_semantics {
    assert -7 % 3 == 2
    assert 7 % -3 == -2
    assert -7.5 % 2.0 == 0.5
    assert 7 / 2 == 3.5
    assert eval(plus, [7, -7], [3, 3]) == [10, -4]
    assert eval(ratio, [7, -7], [2, 2]) == [3.5, -3.5]
    assert eval(remainder, [7, -7], [-3, 3]) == [-2, 2]
    assert eval(remainder_float, [7.5, -7.5], [-2.0, 2.0]) == [-0.5, 0.5]
    assert eval(floor_ratio, [7, -7], [3, 3]) == [2, -3]
}
