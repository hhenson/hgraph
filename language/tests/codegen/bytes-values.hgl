module checks.bytes_values

const fn from_octets(value: list<i64>) -> bytes => bytes(value)

const fn default_empty(value: bytes = bytes()) -> bytes => value

const fn default_octets(value: bytes = bytes([0, 255])) -> bytes => value

const fn byte_count(value: bytes) -> i64 => len(value)

export fn construct(value: atomic<list<i64>>) -> bytes {
    when { return bytes(value) }
}

export fn count(value: bytes) -> i64 {
    when { return len(value) }
}

export fn constant_failure(trigger: i64) -> bytes {
    when { return bytes([256]) }
}

test ordinary_values {
    let empty: bytes = bytes()
    let a: bytes = bytes([0, 255])
    assert empty == bytes([])
    assert len(empty) == 0
    assert len(a) == 2
    assert a == bytes([0, 255])
    assert bytes([0]) < a
    assert bytes([127]) < bytes([128])
    let fixed: list<i64, 2> = [0, 255]
    assert bytes(fixed) == a
    var source: list<i64> = []
    push(source, 0)
    let retained: bytes = bytes(source)
    push(source, 255)
    assert retained == bytes([0])
    assert from_octets(source) == a
    assert byte_count(a) == 2
    assert default_empty() == empty
    assert default_octets() == a
    assert raises("value.byte_range") { bytes([256]) }
    assert raises("value.byte_range") { bytes([-1]) }
}
