module checks.imported_consumer

use checks.imported_contracts as contracts

fn imported_operators(imported_operators: i64) -> i64 => contracts::adjust(imported_operators, 2)
export fn integer(value: i64) -> i64 => imported_operators(value)
export fn real(value: f64) -> f64 => contracts::adjust(value, 0.5)
export fn forward(value: bool) -> bool => contracts::relay(value)
