module checks.test_contexts part helpers

test {
    fn fixture_node(value: i64) -> i64 { when { return fixture_value(value) } }
    fn fixture_pair(value: i64) -> FixturePair {
        when { return FixturePair(left: value, right: fixture_value(value)) }
    }
    fn fixture_kind(kind: FixtureKind) -> FixtureKind => kind
}

test {
    const fn fixture_value(value: i64) -> i64 => value + 1
    struct FixturePair { left: i64
        right: i64 }
    enum FixtureKind { plain = 1, scaled = 2 }
}
