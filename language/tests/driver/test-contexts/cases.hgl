module checks.test_contexts part cases

test {
    test from_cases { assert eval(fixture_node, value: [3]) == [4] }
    test lifted_value { assert eval(const(fixture_value), value: [4]) == [5] }
    test local_types {
        assert eval(fixture_pair, value: [6]) == [delta<FixturePair>(left: 6, right: 7)]
        assert eval(fixture_kind, kind: [FixtureKind::scaled, _, FixtureKind::plain]) == [FixtureKind::scaled, _, FixtureKind::plain]
    }
}

test ordinary { assert eval(fixture_node, value: [5]) == [6] }
