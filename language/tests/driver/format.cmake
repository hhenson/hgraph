file(MAKE_DIRECTORY "${OUT}")
set(source "${OUT}/layout.hgl")
set(original "module layout\nuse missing as missing\noperator add_<T>(lhs:T,rhs:T)->T\nproperties<i64>{commutative,identity=0}\noperator next<T>(value:T)->T\n")
set(expected "module layout\n\nuse missing as missing\n\noperator add_<T>(lhs:T,rhs:T)->T\n    properties<i64>{commutative,identity=0}\n\noperator next<T>(value:T)->T\n")
file(WRITE "${source}" "${original}")
execute_process(COMMAND "${HGL}" fmt "${source}" --check RESULT_VARIABLE status OUTPUT_VARIABLE output)
if(NOT status EQUAL 1)
    message(FATAL_ERROR "fmt --check must reject unformatted input: ${status}")
endif()
file(READ "${source}" unchanged)
if(NOT unchanged STREQUAL original)
    message(FATAL_ERROR "fmt --check modified its source")
endif()
execute_process(COMMAND "${HGL}" fmt "${source}" RESULT_VARIABLE status OUTPUT_VARIABLE output)
string(REPLACE "\r\n" "\n" output "${output}")
if(NOT status EQUAL 0 OR NOT output STREQUAL expected)
    message(FATAL_ERROR "fmt preview mismatch: ${status}: ${output}")
endif()
file(READ "${source}" unchanged)
if(NOT unchanged STREQUAL original)
    message(FATAL_ERROR "fmt preview modified its source")
endif()
execute_process(COMMAND "${HGL}" fmt "${source}" --write RESULT_VARIABLE status)
file(READ "${source}" output)
string(REPLACE "\r\n" "\n" output "${output}")
if(NOT status EQUAL 0 OR NOT output STREQUAL expected)
    message(FATAL_ERROR "fmt --write mismatch: ${status}: ${output}")
endif()
execute_process(COMMAND "${HGL}" fmt "${source}" --check RESULT_VARIABLE status)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "fmt --check rejected formatted input")
endif()
file(WRITE "${source}" "module broken\nfn unfinished(\n")
file(READ "${source}" broken)
execute_process(COMMAND "${HGL}" fmt "${source}" --write RESULT_VARIABLE status)
file(READ "${source}" output)
if(NOT status EQUAL 1 OR NOT output STREQUAL broken)
    message(FATAL_ERROR "fmt --write changed invalid source")
endif()
execute_process(COMMAND "${HGL}" fmt "${source}" --write --check RESULT_VARIABLE status)
if(NOT status EQUAL 2)
    message(FATAL_ERROR "fmt accepted conflicting modes")
endif()
