module hgraph.native part endpoint

cpp include <hgraph/types/time_series/ts_input/base_view.h>

# This is the concrete C++ native substrate used by HGL library code. Keep
# these functions small: they expose operations on current hgraph values and
# live input views; graph scheduling and output mutation remain in HGL nodes.

# `signal` selects the payload-erased TSInputView projection. These operations
# therefore work uniformly for atomic values, structs, collections, windows,
# references, and payload-free signal inputs.

native fn valid(value: signal) -> bool {
    cpp(const hgraph::TSInputView &value) {
        return value.valid();
    }
}

native fn all_valid(value: signal) -> bool {
    cpp(const hgraph::TSInputView &value) {
        return value.all_valid();
    }
}

native fn modified(value: signal) -> bool {
    cpp(const hgraph::TSInputView &value) {
        return value.modified();
    }
}

native fn last_modified(value: signal) -> datetime {
    cpp(const hgraph::TSInputView &value) {
        return value.last_modified_time();
    }
}

# Binding and validity are different: a connected input may not have ticked.
native fn bound(value: signal) -> bool {
    cpp(const hgraph::TSInputView &value) {
        return value.bound();
    }
}

# Read-only subscription status; this does not change input activation.
native fn active(value: signal) -> bool {
    cpp(const hgraph::TSInputView &value) {
        return value.active();
    }
}
