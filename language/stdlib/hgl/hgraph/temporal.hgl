# Parallel calendar and endpoint-metadata operators.
module hgraph.std part temporal

operator datepart<T>(ts: T) -> datetime
operator day<T>(ts: T) -> i64
operator day_of_month<T>(ts: T) -> i64
operator days<T>(ts: T) -> i64
operator hour<T>(ts: T) -> i64
operator isoweekday<T>(ts: T) -> i64
operator microsecond<T>(ts: T) -> i64
operator microseconds<T>(ts: T) -> i64
operator minute<T>(ts: T) -> i64
operator month<T>(ts: T) -> i64
operator month_of_year<T>(ts: T) -> i64
operator second<T>(ts: T) -> i64
operator seconds<T>(ts: T) -> i64
operator timestamp<T>(ts: T) -> f64
operator total_seconds<T>(ts: T) -> f64
operator weekday<T>(ts: T) -> i64
operator year<T>(ts: T) -> i64

impl fn year(ts: date) -> i64 {
    inject out
    when {
        let component = native::year(ts)
        if !valid(out) || out != component {
            out = component
        }
    }
}

impl fn month(ts: date) -> i64 {
    inject out
    when {
        let component = native::month(ts)
        if !valid(out) || out != component {
            out = component
        }
    }
}

impl fn day(ts: date) -> i64 {
    inject out
    when {
        let component = native::day(ts)
        if !valid(out) || out != component {
            out = component
        }
    }
}

impl fn weekday(ts: date) -> i64 {
    when {
        return native::weekday(ts)
    }
}

impl fn isoweekday(ts: date) -> i64 {
    when {
        return native::isoweekday(ts)
    }
}

impl fn year(ts: datetime) -> i64 {
    when {
        return native::year(ts)
    }
}

impl fn month(ts: datetime) -> i64 {
