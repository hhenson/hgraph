module hgraph.native part scalar_values


# Strings follow hgraph::Str (std::string) byte semantics, not Unicode
# code-point or grapheme semantics. Queries do not allocate or retain inputs.
native const fn len(value: str) -> i64

native const fn is_empty(value: str) -> bool

native const fn contains(value: str, needle: str) -> bool

native const fn starts_with(value: str, prefix: str) -> bool

native const fn ends_with(value: str, suffix: str) -> bool

# Scalar projections used by HGL node bodies. These functions never wire or
# invoke a temporal operator; their inputs are current scalar values.

native const fn truthy(value: bool) -> bool

native const fn truthy(value: i64) -> bool

native const fn truthy(value: f64) -> bool

native const fn truthy(value: str) -> bool

native const fn absolute(value: i64) -> i64

native const fn absolute(value: f64) -> f64

native const fn logarithm(value: f64) -> f64

native const fn round_decimal(value: f64, digits: i64) -> f64 throws

native const fn invert(value: bool) -> i64

native const fn bit_and(lhs: bool, rhs: bool) -> bool

native const fn bit_or(lhs: bool, rhs: bool) -> bool

native const fn bit_xor(lhs: bool, rhs: bool) -> bool

native const fn invert(value: i64) -> i64

native const fn bit_or(lhs: i64, rhs: i64) -> i64

native const fn bit_xor(lhs: i64, rhs: i64) -> i64

# Private value helpers; eval uses the same default lifting as graph composition.
test {
    const fn test_text_length(value: str) -> i64 => len(value)
    const fn test_text_empty(value: str) -> bool => is_empty(value)
    const fn test_text_contains(value: str, needle: str) -> bool => contains(value, needle)
    const fn test_text_prefix(value: str, prefix: str) -> bool => starts_with(value, prefix)
    const fn test_text_suffix(value: str, suffix: str) -> bool => ends_with(value, suffix)

    test text_length_and_silent_ticks {
        assert eval(test_text_length, value: ["hgl", _, ""]) == [3, _, 0]
    }

    test text_emptiness {
        assert eval(test_text_empty, value: ["hgl", ""]) == [false, true]
    }

    test text_membership {
        assert eval(test_text_contains, value: ["hgraph", "hgraph", "", "abc"],
                    needle: ["graph", "Graph", "", "abcd"]) == [true, false, true, false]
    }

    test text_prefix {
        assert eval(test_text_prefix, value: ["hgraph", "hgraph", "", "abc"],
                    prefix: ["hg", "graph", "", "abcd"]) == [true, false, true, false]
    }

    test text_suffix {
        assert eval(test_text_suffix, value: ["hgraph", "hgraph", "", "abc"],
                    suffix: ["graph", "hg", "", "abcd"]) == [true, false, true, false]
    }
}

test {
    const fn scalar_truth(value: f64) -> bool => truthy(value)
    const fn string_truth(value: str) -> bool => truthy(value)
    const fn bit_intersection(lhs: i64, rhs: i64) -> i64 => bit_and(lhs, rhs)
    const fn scalar_round(value: f64, digits: i64) -> f64 => round_decimal(value, digits)

    test truthiness_is_a_value_operation {
        assert eval(scalar_truth, value: [0.0, -1.0, 2.0]) == [false, true, true]
        assert eval(string_truth, value: ["", "x"]) == [false, true]
    }

    test integer_bit_projection {
        assert eval(bit_intersection, lhs: [6, -1], rhs: [3, 7]) == [2, 7]
    }

    test decimal_rounding {
        assert eval(scalar_round, value: [2.675, 2.5, 3.5], digits: [2, 0, 0]) == [2.67, 2.0, 4.0]
    }
}

native const fn as_int(value: bool) -> i64

# Checked kernels bind the reviewed scalar algorithms in hgraph's lifted
# kernel library. `throws` records that a call may raise: a negative or
# too-large shift count, a negative integer exponent, an overflowing integer
# power, and zero raised to a negative power are all errors, exactly as the
# native temporal operators report them. The raise ends the evaluation under
# hgraph's node error model (ADR 0009).

# Configuration checks a node runs in `start`, as the native stream nodes do.
# A value native is available in every hook; the raise ends the start under
# hgraph's node error model with the native message (ADR 0009).
native const fn require_positive_delay(delay: duration) throws

native const fn power(lhs: i64, rhs: i64) -> i64 throws

native const fn power(lhs: f64, rhs: f64) -> f64 throws

native const fn shift_left(lhs: i64, rhs: i64) -> i64 throws

native const fn shift_right(lhs: i64, rhs: i64) -> i64 throws

# Python slice positions: a negative index counts from the end, positions are
# clamped to the string, and an inverted range is empty. Never raises.
native const fn slice(value: str, begin: i64, end: i64) -> str

test {
    const fn integer_power(lhs: i64, rhs: i64) -> i64 => power(lhs, rhs)
    const fn float_power(lhs: f64, rhs: f64) -> f64 => power(lhs, rhs)
    const fn left(lhs: i64, rhs: i64) -> i64 => shift_left(lhs, rhs)
    const fn right(lhs: i64, rhs: i64) -> i64 => shift_right(lhs, rhs)
    const fn text_slice(value: str, begin: i64, end: i64) -> str => slice(value, begin, end)

    test checked_powers {
        assert eval(integer_power, lhs: [2, -3, 0], rhs: [10, 3, 0]) == [1024, -27, 1]
        assert eval(float_power, lhs: [2.0, 4.0], rhs: [0.5, -1.0]) == [1.4142135623730951, 0.25]
    }

    test checked_shifts {
        assert eval(left, lhs: [1, 0, -1], rhs: [3, 70, 1]) == [8, 0, -2]
        assert eval(right, lhs: [8, -8, 1], rhs: [3, 1, 70]) == [1, -4, 0]
    }

    test python_slices {
        assert eval(text_slice, value: ["hgraph", "hgraph", "hgraph", "hgraph"],
                    begin: [0, -5, 4, 9], end: [2, 3, 2, 12]) == ["hg", "gr", "", ""]
    }
}

native const fn as_int(value: f64) -> i64

native const fn as_float(value: bool) -> f64

native const fn as_float(value: i64) -> f64
