module hgraph.native part windows

cpp include <hgraph/types/time_series/ts_input/window_view.h>

# These patterns describe tick-count windows. Duration extents need native
# descriptor support before equivalent duration-window overloads can be added.
# All queries require a bound window; normal `when {}` guards ensure validity.
native fn len<T, const max_size: i64, const min_size: i64>(
    value: rolling<T, max_size, min_size>
) -> i64 {
    cpp(const hgraph::TSWInputView &value) {
        return static_cast<hgraph::Int>(value.size());
    }
}

native fn is_empty<T, const max_size: i64, const min_size: i64>(
    value: rolling<T, max_size, min_size>
) -> bool {
    cpp(const hgraph::TSWInputView &value) {
        return value.empty();
    }
}

native fn capacity<T, const max_size: i64, const min_size: i64>(
    value: rolling<T, max_size, min_size>
) -> i64 {
    cpp(const hgraph::TSWInputView &value) {
        return static_cast<hgraph::Int>(value.capacity());
    }
}

native fn period<T, const max_size: i64, const min_size: i64>(
    value: rolling<T, max_size, min_size>
) -> i64 {
    cpp(const hgraph::TSWInputView &value) {
        return static_cast<hgraph::Int>(value.period());
    }
}

native fn min_period<T, const max_size: i64, const min_size: i64>(
    value: rolling<T, max_size, min_size>
) -> i64 {
    cpp(const hgraph::TSWInputView &value) {
        return static_cast<hgraph::Int>(value.min_period());
    }
}

native fn is_full<T, const max_size: i64, const min_size: i64>(
    value: rolling<T, max_size, min_size>
) -> bool {
    cpp(const hgraph::TSWInputView &value) {
        return value.full();
    }
}

# True only in the evaluation where the window evicted a value.
native fn has_removed_value<T, const max_size: i64, const min_size: i64>(
    value: rolling<T, max_size, min_size>
) -> bool {
    cpp(const hgraph::TSWInputView &value) {
        return value.has_removed_value();
    }
}

# Timestamp of the oldest retained sample, not the first-ever modification.
native fn first_modified<T, const max_size: i64, const min_size: i64>(
    value: rolling<T, max_size, min_size>
) -> datetime {
    cpp(const hgraph::TSWInputView &value) {
        return value.first_modified_time();
    }
}
