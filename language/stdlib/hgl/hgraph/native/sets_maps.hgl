module hgraph.native part sets_maps

cpp include <hgraph/types/time_series/ts_input/dict_view.h>
cpp include <hgraph/types/time_series/ts_input/set_view.h>

native fn len<T>(value: set<T>) -> i64 {
    cpp(const hgraph::TSSInputView &value) {
        return static_cast<hgraph::Int>(value.size());
    }
}

native fn len<K, V>(value: map<K, V>) -> i64 {
    cpp(const hgraph::TSDInputView &value) {
        return static_cast<hgraph::Int>(value.size());
    }
}

native fn is_empty<T>(value: set<T>) -> bool {
    cpp(const hgraph::TSSInputView &value) {
        return value.empty();
    }
}

native fn is_empty<K, V>(value: map<K, V>) -> bool {
    cpp(const hgraph::TSDInputView &value) {
        return value.empty();
    }
}

# Construct collections in HGL so the functions see genuine structural inputs.
test {
    fn test_set_source(value: i64) -> set<i64> {
        inject out
        when {
            if value > 0 { upsert(out, value) } else { discard(out, -value) }
        }
    }
    fn test_set_length(value: set<i64>) -> i64 { when { return len(value) } }
    fn test_set_empty(value: set<i64>) -> bool { when { return is_empty(value) } }
    fn test_set_length_graph(value: i64) -> i64 { test_set_length(test_set_source(value)) }
    fn test_set_empty_graph(value: i64) -> bool { test_set_empty(test_set_source(value)) }

    fn test_map_source(value: i64) -> map<i64, i64> {
        inject out
        when {
            if value > 0 { upsert(out, value, value) } else { discard(out, -value) }
        }
    }
    fn test_map_length(value: map<i64, i64>) -> i64 { when { return len(value) } }
    fn test_map_empty(value: map<i64, i64>) -> bool { when { return is_empty(value) } }
    fn test_map_length_graph(value: i64) -> i64 { test_map_length(test_map_source(value)) }
    fn test_map_empty_graph(value: i64) -> bool { test_map_empty(test_map_source(value)) }

    # Returning a borrowed projection aligns owned output contents, not a reference.
    fn test_map_keys(value: map<i64, i64>) -> set<i64> {
        when { return key_set(value) }
    }
    fn test_map_keys_length(value: i64) -> i64 {
        test_set_length(test_map_keys(test_map_source(value)))
    }

    test set_membership_queries {
        assert eval(test_set_length_graph, value: [1, 2, -1, -2]) == [1, 2, 1, 0]
        assert eval(test_set_empty_graph, value: [1, 2, -1, -2]) == [false, false, false, true]
    }

    test map_membership_queries {
        assert eval(test_map_length_graph, value: [1, 2, 1, -1, -2]) == [1, 2, 2, 1, 0]
        assert eval(test_map_empty_graph, value: [1, -1]) == [false, true]
    }

    test returned_key_set_alignment {
        assert eval(test_map_keys_length, value: [1, 2, 1, -1, -2]) == [1, 2, 2, 1, 0]
    }
}
