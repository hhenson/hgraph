# The len_ and is_empty source candidates have graduated into the compiled
# ../standard.hgl slice. They are not duplicated here: that source also owns
# unchanged-output suppression and records the remaining identity, startup,
# rolling, and TSB parity blockers as HGL-LIB-001 through HGL-LIB-004.

impl fn sum_<T, const size: i64>(values: list<T, size>) -> T
requires T in {i64, f64}
{
    when {
        var total: T = 0
        for value in elements(values) {
            total += value
        }
        return total
    }
}

instantiate sum_<i64, _>, sum_<f64, _>

impl fn mean<const size: i64>(values: list<f64, size>) -> f64 =>
    sum_(values) / len_(values)

# PARTIAL HGL-MIG-006: iterator selectors are implemented and the functional
# output-mutation names are accepted, but their compiler/C++ wrapper lowering
# is not. `upsert` is required here because either input may already provide
# the same set member.
impl fn union<T>(lhs: set<T>, rhs: set<T>) -> set<T> {
    inject out

    when modified(lhs) && valid(lhs) {
        for value in elements(lhs, added) {
            upsert(out, value)
        }
        for value in elements(lhs, removed) {
            remove(out, value)
        }
    }

    when modified(rhs) && valid(rhs) {
        for value in elements(rhs, added) {
            upsert(out, value)
        }
        # Correct union removal needs membership in the other input. This is
        # intentionally left incomplete until collection-view membership and
        # simultaneous-delta semantics are specified.
    }
}

# PROVISIONAL HGL-MIG-007: the exact standalone native pass-through node can
# be expressed once delta(value) has a type-preserving result.
fn pass_through<T>(value: T) -> T {
    when {
        return delta(value)
    }
}
