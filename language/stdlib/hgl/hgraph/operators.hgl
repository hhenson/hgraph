impl fn and_(lhs: bool, rhs: bool) -> bool {
    when {
        return native::truthy(lhs) && native::truthy(rhs)
    }
}

impl fn and_(lhs: i64, rhs: i64) -> bool {
    when {
        return native::truthy(lhs) && native::truthy(rhs)
    }
}

impl fn and_(lhs: f64, rhs: f64) -> bool {
    when {
        return native::truthy(lhs) && native::truthy(rhs)
    }
}

impl fn and_(lhs: str, rhs: str) -> bool {
    when {
        return native::truthy(lhs) && native::truthy(rhs)
    }
}

impl fn and_(lhs: i64, rhs: f64) -> bool {
    when {
        return native::truthy(lhs) && native::truthy(rhs)
    }
}

impl fn and_(lhs: f64, rhs: i64) -> bool {
    when {
        return native::truthy(lhs) && native::truthy(rhs)
    }
}

impl fn or_(lhs: bool, rhs: bool) -> bool {
    when {
        return native::truthy(lhs) || native::truthy(rhs)
    }
}

impl fn or_(lhs: i64, rhs: i64) -> bool {
    when {
        return native::truthy(lhs) || native::truthy(rhs)
    }
}

impl fn or_(lhs: f64, rhs: f64) -> bool {
    when {
        return native::truthy(lhs) || native::truthy(rhs)
    }
}

impl fn or_(lhs: str, rhs: str) -> bool {
    when {
        return native::truthy(lhs) || native::truthy(rhs)
    }
}

impl fn or_(lhs: i64, rhs: f64) -> bool {
    when {
        return native::truthy(lhs) || native::truthy(rhs)
    }
}

impl fn or_(lhs: f64, rhs: i64) -> bool {
    when {
        return native::truthy(lhs) || native::truthy(rhs)
    }
}

impl fn not_(ts: bool) -> bool {
    when {
        return !native::truthy(ts)
    }
}

impl fn not_(ts: i64) -> bool {
    when {
        return !native::truthy(ts)
    }
}

impl fn not_(ts: f64) -> bool {
    when {
        return !native::truthy(ts)
    }
}

impl fn not_(ts: str) -> bool {
    when {
        return !native::truthy(ts)
    }
}

impl fn eq_(lhs: f64, rhs: f64) -> bool {
    when {
        let difference = rhs - lhs
        return -1e-10 <= difference && difference <= 1e-10
    }
}

impl fn eq_(lhs: i64, rhs: f64) -> bool {
    when {
        let difference = rhs - (lhs + 0.0)
        return -1e-10 <= difference && difference <= 1e-10
    }
}

impl fn eq_(lhs: f64, rhs: i64) -> bool {
    when {
        let difference = (rhs + 0.0) - lhs
        return -1e-10 <= difference && difference <= 1e-10
    }
}

operator abs_<T>(ts: T) -> T
operator pos_<T>(ts: T) -> T
operator sign<T>(ts: T) -> T
operator ln(ts: f64) -> f64
operator round_(ts: f64, n_digits: i64) -> f64
operator invert_<T>(ts: T) -> i64
operator bit_and<T>(lhs: T, rhs: T) -> T
operator bit_or<T>(lhs: T, rhs: T) -> T
operator bit_xor<T>(lhs: T, rhs: T) -> T

impl fn abs_(ts: i64) -> i64 {
    when {
        return native::absolute(ts)
    }
}

impl fn pos_(ts: i64) -> i64 {
    when {
        return ts
    }
}

impl fn sign(ts: i64) -> i64 {
    when {
        if ts < 0 {
            return -1
        }
        return 1
    }
}

impl fn abs_(ts: f64) -> f64 {
    when {
        return native::absolute(ts)
    }
}

impl fn pos_(ts: f64) -> f64 {
    when {
        return ts
    }
}

impl fn sign(ts: f64) -> f64 {
    when {
        if ts < 0.0 {
            return -1.0
        }
        return 1.0
    }
}

impl fn ln(ts: f64) -> f64 {
    when {
        return native::logarithm(ts)
    }
}

impl fn round_(ts: f64, n_digits: i64) -> f64 {
    when {
        return native::round_decimal(ts, n_digits)
    }
}

impl fn invert_(ts: i64) -> i64 {
    when {
        return native::invert(ts)
    }
}

impl fn bit_and(lhs: i64, rhs: i64) -> i64 {
    when {
        return native::bit_and(lhs, rhs)
    }
}

impl fn bit_or(lhs: i64, rhs: i64) -> i64 {
    when {
        return native::bit_or(lhs, rhs)
    }
}

impl fn bit_xor(lhs: i64, rhs: i64) -> i64 {
    when {
        return native::bit_xor(lhs, rhs)
    }
}

impl fn invert_(ts: bool) -> i64 {
    when {
        return native::invert(ts)
    }
}

impl fn bit_and(lhs: bool, rhs: bool) -> bool {
    when {
        return native::bit_and(lhs, rhs)
    }
}

impl fn bit_or(lhs: bool, rhs: bool) -> bool {
    when {
        return native::bit_or(lhs, rhs)
    }
}

impl fn bit_xor(lhs: bool, rhs: bool) -> bool {
    when {
        return native::bit_xor(lhs, rhs)
    }
}

operator min_<L, R, O>(lhs: L, rhs: R) -> O
operator max_<L, R, O>(lhs: L, rhs: R) -> O

impl fn min_(lhs: i64, rhs: i64) -> i64 {
    when {
        if rhs < lhs {
            return rhs
        }
        return lhs
    }
}

impl fn min_(lhs: f64, rhs: f64) -> f64 {
    when {
        if rhs < lhs {
            return rhs
        }
        return lhs
    }
}

impl fn min_(lhs: str, rhs: str) -> str {
    when {
        if rhs < lhs {
            return rhs
        }
        return lhs
    }
}

impl fn min_(lhs: date, rhs: date) -> date {
    when {
        if rhs < lhs {
            return rhs
        }
        return lhs
    }
}

impl fn min_(lhs: datetime, rhs: datetime) -> datetime {
    when {
        if rhs < lhs {
            return rhs
        }
        return lhs
    }
}

impl fn min_(lhs: duration, rhs: duration) -> duration {
    when {
        if rhs < lhs {
            return rhs
        }
        return lhs
    }
}

impl fn min_(lhs: i64, rhs: f64) -> f64 {
    when {
        if rhs < lhs {
            return rhs
        }
        return lhs + 0.0
    }
}

impl fn min_(lhs: f64, rhs: i64) -> f64 {
    when {
        if rhs < lhs {
            return rhs + 0.0
        }
        return lhs
    }
}

impl fn max_(lhs: i64, rhs: i64) -> i64 {
    when {
        if rhs > lhs {
            return rhs
        }
        return lhs
    }
}

impl fn max_(lhs: f64, rhs: f64) -> f64 {
    when {
        if rhs > lhs {
            return rhs
        }
        return lhs
    }
}

impl fn max_(lhs: str, rhs: str) -> str {
    when {
        if rhs > lhs {
            return rhs
        }
        return lhs
    }
}

impl fn max_(lhs: date, rhs: date) -> date {
    when {
        if rhs > lhs {
            return rhs
        }
        return lhs
    }
}

impl fn max_(lhs: datetime, rhs: datetime) -> datetime {
    when {
        if rhs > lhs {
            return rhs
        }
        return lhs
    }
}

impl fn max_(lhs: duration, rhs: duration) -> duration {
    when {
        if rhs > lhs {
            return rhs
        }
        return lhs
    }
}

impl fn max_(lhs: i64, rhs: f64) -> f64 {
    when {
        if rhs > lhs {
            return rhs
        }
        return lhs + 0.0
    }
}

impl fn max_(lhs: f64, rhs: i64) -> f64 {
    when {
        if rhs > lhs {
            return rhs + 0.0
        }
        return lhs
    }
}

operator contains_(ts: str, item: str) -> bool
impl fn contains_(ts: str, item: str) -> bool {
    when { return native::contains(ts, item) }
}

# Python slice semantics through the exposed native value function; the
# native operator's live start/end positions are ordinary temporal inputs.
# `start` is a reserved word in HGL, so the parallel identity names the
# positions `begin`/`end`; positional calls are unaffected.
operator substr(s: str, begin: i64, end: i64) -> str
impl fn substr(s: str, begin: i64, end: i64) -> str {
    when { return native::slice(s, begin, end) }
}

# Checked arithmetic: the native `throws` bindings raise on a negative
# integer exponent, an overflowing integer power, zero raised to a negative
# power, and a negative or too-large shift count. The raise ends the
# evaluation under hgraph's node error model (ADR 0009); there is no divide-
# by-zero policy parameter on these parallel identities yet.
operator pow_<L, R, O>(lhs: L, rhs: R) -> O
impl fn pow_(lhs: i64, rhs: i64) -> i64 {
    when { return native::power(lhs, rhs) }
}
impl fn pow_(lhs: f64, rhs: f64) -> f64 {
    when { return native::power(lhs, rhs) }
}
impl fn pow_(lhs: i64, rhs: f64) -> f64 {
    when { return native::power(lhs + 0.0, rhs) }
}
impl fn pow_(lhs: f64, rhs: i64) -> f64 {
    when { return native::power(lhs, rhs + 0.0) }
}

operator lshift_<T>(lhs: T, rhs: T) -> T
operator rshift_<T>(lhs: T, rhs: T) -> T
impl fn lshift_(lhs: i64, rhs: i64) -> i64 {
    when { return native::shift_left(lhs, rhs) }
}
impl fn rshift_(lhs: i64, rhs: i64) -> i64 {
    when { return native::shift_right(lhs, rhs) }
}
operator mean<L, R>(lhs: L, rhs: R) -> f64
impl fn mean(lhs: i64, rhs: i64) -> f64 {
    when { return ((lhs + 0.0) + (rhs + 0.0)) / 2.0 }
}
impl fn mean(lhs: f64, rhs: f64) -> f64 {
    when { return ((lhs + 0.0) + (rhs + 0.0)) / 2.0 }
}
impl fn mean(lhs: i64, rhs: f64) -> f64 {
    when { return ((lhs + 0.0) + (rhs + 0.0)) / 2.0 }
}
impl fn mean(lhs: f64, rhs: i64) -> f64 {
    when { return ((lhs + 0.0) + (rhs + 0.0)) / 2.0 }
}
impl fn pos_(ts: duration) -> duration {
    when { return ts }
}

test {
    fn equals(lhs: f64, rhs: f64) -> bool => eq_(lhs, rhs)
    fn positive_sign(ts: i64) -> i64 => sign(ts)
    fn average(lhs: i64, rhs: i64) -> f64 => mean(lhs, rhs)
    test equality_uses_native_default_tolerance {
        assert eval(equals, lhs: [0.0, 1.0, 1.0], rhs: [1e-11, 1.0, 1.000001]) == [true, true, false]
    }
    test zero_sign_and_mean {
        assert eval(positive_sign, ts: [-1, 0, 1]) == [-1, 1, 1]
        assert eval(average, lhs: [2, 4], rhs: [4, 8]) == [3.0, 6.0]
    }
    fn integer_power(lhs: i64, rhs: i64) -> i64 => pow_(lhs, rhs)
    fn mixed_power(lhs: i64, rhs: f64) -> f64 => pow_(lhs, rhs)
    fn shifted_left(lhs: i64, rhs: i64) -> i64 => lshift_(lhs, rhs)
    fn shifted_right(lhs: i64, rhs: i64) -> i64 => rshift_(lhs, rhs)
    fn sliced(s: str, begin: i64, end: i64) -> str => substr(s, begin, end)
    test checked_arithmetic_values {
        assert eval(integer_power, lhs: [2, 3, _], rhs: [10, _, 2]) == [1024, 59049, 9]
        assert eval(mixed_power, lhs: [4, 2], rhs: [0.5, -1.0]) == [2.0, 0.5]
        assert eval(shifted_left, lhs: [1, 0], rhs: [4, 70]) == [16, 0]
        assert eval(shifted_right, lhs: [-16, 1], rhs: [2, 70]) == [-4, 0]
    }
    test substring_slices {
        assert eval(sliced, s: ["hgraph", _, "hgraph"], begin: [1, 2, -2], end: [3, 4, 100]) == ["gr", "ra", "ph"]
    }
}

# Ordered legacy temporal scalar domains use HGL comparisons.
instantiate eq_<date, date>, eq_<datetime, datetime>, eq_<duration, duration>, ne_<date, date>, ne_<datetime, datetime>, ne_<duration, duration>, lt_<date, date>, lt_<datetime, datetime>, lt_<duration, duration>, le_<date, date>, le_<datetime, datetime>, le_<duration, duration>, gt_<date, date>, gt_<datetime, datetime>, gt_<duration, duration>, ge_<date, date>, ge_<datetime, datetime>, ge_<duration, duration>

operator eq_epsilon<L, R>(lhs: L, rhs: R, const epsilon: f64 = 1e-10) -> bool
impl fn eq_epsilon(lhs: f64, rhs: f64, const epsilon: f64 = 1e-10) -> bool {
    when {
        let difference = (rhs + 0.0) - (lhs + 0.0)
        return -epsilon <= difference && difference <= epsilon
    }
}
impl fn eq_epsilon(lhs: i64, rhs: f64, const epsilon: f64 = 1e-10) -> bool {
    when {
        let difference = (rhs + 0.0) - (lhs + 0.0)
        return -epsilon <= difference && difference <= epsilon
    }
}
impl fn eq_epsilon(lhs: f64, rhs: i64, const epsilon: f64 = 1e-10) -> bool {
    when {
        let difference = (rhs + 0.0) - (lhs + 0.0)
        return -epsilon <= difference && difference <= epsilon
    }
}

instantiate eq_<time, time>, ne_<time, time>
