    state have_last: bool = false
    state last: duration = 0us
    when {
        let changed = !have_last || last != ts
        last = ts
        have_last = true
        if changed {
            return ts
        }
    }
}

test {
    fn first_two(ts: i64) -> i64 => take(ts, 2)
    fn frozen(predicate: bool, ts: i64) -> i64 => freeze(predicate, ts)
    fn latched(ts: bool) -> bool => until_true(ts)
    test take_passivates_after_count {
        assert eval(first_two, ts: [1, 2, 3, 4]) == [1, 2, _, _]
    }
    test freeze_holds_the_last_value_once_true {
        assert eval(frozen, predicate: [false, false, true, false], ts: [1, 2, 3, 4]) == [1, 2, 3, _]
    }
    test until_true_stops_listening_once_true {
        assert eval(latched, ts: [false, false, true, false]) == [false, false, true, _]
    }
    fn sample_integer(signal: bool, ts: i64) -> i64 => sample(signal, ts)
    fn drop_integer(ts: i64, const count: i64 = 1) -> i64 => drop(ts, count)
    fn dedup_integer(ts: i64) -> i64 => dedup(ts)
    fn filter_integer(condition: bool, ts: i64) -> i64 => filter_(condition, ts)

    test sample_uses_only_trigger_ticks {
        assert eval(sample_integer, signal: [_, true, _, true, true], ts: [1, 2, 3, 4, _]) == [_, 2, _, 4, 4]
    }

    test drop_counts_ticks_not_cycles {
        assert eval(drop_integer, ts: [1, _, 1, 2, 2], count: 2) == [_, _, _, 2, 2]
        assert eval(drop_integer, ts: [1, _, 2], count: -1) == [1, _, 2]
    }

    test dedup_remembers_zero_and_empty_cycles {
        assert eval(dedup_integer, ts: [_, 0, 0, _, 1, 1, 0]) == [_, 0, _, _, 1, _, 0]
    }

    test filter_resynchronizes_on_reopen {
        assert eval(filter_integer, condition: [true, false, false, true, true, _], ts: [1, 2, 3, _, _, 4]) == [1, _, _, 3, _, 4]
        assert eval(filter_integer, condition: [true, false, true], ts: [1, _, _]) == [1, _, _]
    }
}

# Distinct parallel names retain overload-specific signatures while production
# operator-family consolidation remains a separate publication step.
operator dedup_float(ts: f64, abs_tol: f64) -> f64
impl fn dedup_float(ts: f64, abs_tol: f64) -> f64 {
    state have_last: bool = false
    state last: f64 = 0.0
    when {
        let difference = ts - last
        if !have_last || !(-abs_tol < difference && difference < abs_tol) {
            last = ts
            have_last = true
            return ts
        }
    }
}
operator sum<T>(ts: T) -> T
operator sum_reset<T>(ts: T, reset: bool) -> T
operator mean<T>(ts: T) -> f64
operator min_<T>(ts: T) -> T
operator max_<T>(ts: T) -> T

impl fn sum(ts: i64) -> i64 {
    inject out
    when {
        if valid(out) { return out + ts }
        return 0 + ts
    }
}
impl fn sum_reset(ts: i64, reset: bool) -> i64 {
    inject out
    when valid(reset) && modified(reset) {
        if valid(ts) && modified(ts) { return ts }
        return 0
    }
    when valid(ts) && modified(ts) {
        if valid(out) { return out + ts }
        return ts
    }
}

impl fn mean(ts: i64) -> f64 {
    state count: i64 = 0
    inject out
    when {
        count += 1
        if valid(out) { return out + ((ts + 0.0) - out) / (count + 0.0) }
        return (ts + 0.0) / (count + 0.0)
    }
}

impl fn sum(ts: f64) -> f64 {
    inject out
    when {
        if valid(out) { return out + ts }
        return 0.0 + ts
    }
}
impl fn sum_reset(ts: f64, reset: bool) -> f64 {
    inject out
    when valid(reset) && modified(reset) {
        if valid(ts) && modified(ts) { return ts }
        return 0.0
    }
    when valid(ts) && modified(ts) {
        if valid(out) { return out + ts }
        return ts
    }
}

impl fn mean(ts: f64) -> f64 {
    state count: i64 = 0
    inject out
    when {
        count += 1
        if valid(out) { return out + ((ts + 0.0) - out) / (count + 0.0) }
        return (ts + 0.0) / (count + 0.0)
    }
}

impl fn min_(ts: i64) -> i64 {
    inject out
    when {
        if !valid(out) || ts < out { return ts }
    }
}

impl fn max_(ts: i64) -> i64 {
    inject out
    when {
        if !valid(out) || ts > out { return ts }
    }
}

impl fn min_(ts: f64) -> f64 {
    inject out
    when {
        if !valid(out) || ts < out { return ts }
    }
}

impl fn max_(ts: f64) -> f64 {
    inject out
    when {
        if !valid(out) || ts > out { return ts }
    }
}

