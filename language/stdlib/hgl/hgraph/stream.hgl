}

impl fn dedup(ts: f64) -> f64 {
    state have_last: bool = false
    state last: f64 = 0.0
    when {
        let difference = ts - last
        if !have_last || !(-1e-15 < difference && difference < 1e-15) {
            last = ts
            have_last = true
            return ts
        }
    }
}

test {
    fn sum_integer(ts: i64) -> i64 => sum(ts)
    fn reset_integer(ts: i64, reset: bool) -> i64 => sum_reset(ts, reset)
    fn mean_integer(ts: i64) -> f64 => mean(ts)
    fn dedup_tolerance(ts: f64, abs_tol: f64) -> f64 => dedup_float(ts, abs_tol)
    test folds_and_reset_before_first_value {
        assert eval(sum_integer, ts: [_, 0, 3, 3, _, -2]) == [_, 0, 3, 6, _, 4]
        assert eval(reset_integer, ts: [_, 2, 3, _, 1], reset: [true, _, false, false, _]) == [0, 2, 3, 0, 1]
        assert eval(mean_integer, ts: [_, 2, 4, _, 6]) == [_, 2.0, 3.0, _, 4.0]
    }
    test dedup_tracks_last_emitted_value {
        assert eval(dedup_tolerance, ts: [0.0, 0.5, 1.0, 1.5, 2.0], abs_tol: [1.0, _, _, _, _]) == [0.0, _, 1.0, _, 2.0]
    }
}


impl fn min_(ts: bool) -> bool {
    inject out
    when { if !valid(out) || (!ts && out) { return ts } }
}
impl fn max_(ts: bool) -> bool {
    inject out
    when { if !valid(out) || (ts && !out) { return ts } }
}

# Parallel name for the internal core __tick_count node.
operator tick_count(ts: signal) -> i64
impl fn tick_count(ts: signal) -> i64 {
    inject out
    when {
        if valid(out) { return out + 1 }
        return 1
    }
}
