    when { upsert(out, key, value) }
}
operator make_tsd_remove<K, V>(key: K, value: V, remove_key: bool) -> map<K, V>
impl fn make_tsd_remove<K>(key: K, value: bool, remove_key: bool) -> map<K, bool> {
    inject out
    when valid(key) && modified(key, value, remove_key) {
        let remove = valid(remove_key) && remove_key && (modified(key) || modified(remove_key))
        if remove {
            discard(out, key)
        } else if valid(value) && (modified(key) || modified(value)) {
            upsert(out, key, value)
        }
    }
}
impl fn make_tsd_remove<K>(key: K, value: i64, remove_key: bool) -> map<K, i64> {
    inject out
    when valid(key) && modified(key, value, remove_key) {
        let remove = valid(remove_key) && remove_key && (modified(key) || modified(remove_key))
        if remove {
            discard(out, key)
        } else if valid(value) && (modified(key) || modified(value)) {
            upsert(out, key, value)
        }
    }
}
impl fn make_tsd_remove<K>(key: K, value: f64, remove_key: bool) -> map<K, f64> {
    inject out
    when valid(key) && modified(key, value, remove_key) {
        let remove = valid(remove_key) && remove_key && (modified(key) || modified(remove_key))
        if remove {
            discard(out, key)
        } else if valid(value) && (modified(key) || modified(value)) {
