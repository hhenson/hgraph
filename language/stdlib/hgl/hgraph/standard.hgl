# Scalar-valued map accumulation. TSS accumulation remains blocked: native
# duplicate adds publish an empty delta, but HGL upsert suppresses that event.
# Map reset/exclusion needs prior-output traversal and optional-input signatures.
operator collect_map<K, V>(key: K, ts: V) -> map<K, V>
impl fn collect_map<K>(key: K, ts: bool) -> map<K, bool> {
    inject out
    when { upsert(out, key, ts) }
}
impl fn collect_map<K>(key: K, ts: i64) -> map<K, i64> {
    inject out
    when { upsert(out, key, ts) }
}
impl fn collect_map<K>(key: K, ts: f64) -> map<K, f64> {
    inject out
    when { upsert(out, key, ts) }
}
impl fn collect_map<K>(key: K, ts: str) -> map<K, str> {
    inject out
    when { upsert(out, key, ts) }
}
impl fn collect_map<K>(key: K, ts: date) -> map<K, date> {
    inject out
    when { upsert(out, key, ts) }
}
impl fn collect_map<K>(key: K, ts: time) -> map<K, time> {
    inject out
    when { upsert(out, key, ts) }
}
impl fn collect_map<K>(key: K, ts: datetime) -> map<K, datetime> {
    inject out
    when { upsert(out, key, ts) }
}
impl fn collect_map<K>(key: K, ts: duration) -> map<K, duration> {
    inject out
    when { upsert(out, key, ts) }
}
