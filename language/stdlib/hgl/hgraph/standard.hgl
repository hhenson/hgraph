impl fn contains_(ts: set<i64>, item: i64) -> bool {
    inject out
    when modified(ts, item) && valid(item) {
        if native::bound(ts) {
            let present = valid(ts) && contains(ts, item)
            if modified(item) || !valid(out) || out != present { return present }
        }
    }
}

impl fn contains_<V>(ts: map<i64, V>, item: i64) -> bool {
    inject out
    when modified(ts, item) && valid(item) {
        if native::bound(ts) {
            let present = valid(ts) && contains(key_set(ts), item)
            if modified(item) || !valid(out) || out != present { return present }
        }
    }
}

