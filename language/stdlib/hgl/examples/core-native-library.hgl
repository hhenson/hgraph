module examples.core_native_library

use hgraph.native as native

export fn set_contains(value: set<i64>, key: i64) -> bool {
    when { return contains(value, key) }
}

export fn map_contains(value: map<i64, f64>, key: i64) -> bool {
    when { return contains(value, key) }
}

export fn map_key_set_contains(value: map<i64, f64>, key: i64) -> bool {
    when { return contains(key_set(value), key) }
}

export fn map_at(value: map<i64, f64>, key: i64) -> f64 {
    when { return at(value, key) }
}

export fn map_at_valid(value: map<i64, f64>, key: i64) -> bool {
    when { return valid(at(value, key)) }
}

export fn map_at_modified(value: map<i64, f64>, key: i64) -> bool {
    when { return modified(at(value, key)) }
}

fn map_invalid_child_source(value: i64) -> map<i64, f64> {
    inject out
    when {
        if value > 0 { upsert(out, 1, 1.0) } else { invalidate(out, 1) }
    }
}

export fn map_invalid_child_valid(value: i64, key: i64) -> bool {
    map_at_valid(map_invalid_child_source(value), key)
}

export fn map_key_values(value: map<i64, f64>) -> set<i64> {
    when { return key_set(value) }
}

export fn map_key_values_assigned(value: map<i64, f64>) -> set<i64> {
    inject out
    when {
        let keys = key_set(value)
        out = keys
    }
}

export fn map_child_set(value: map<i64, set<i64>>, key: i64) -> set<i64> {
    when { return at(value, key) }
}

export fn list_child_set(value: list<set<i64>, 2>, index: i64) -> set<i64> {
    when {
        let child = at(value, index)
        return child
    }
}

export fn map_child_map(value: map<i64, map<i64, f64>>, key: i64) -> map<i64, f64> {
    when { return at(value, key) }
}

export fn map_child_list(value: map<i64, list<i64, 2>>, key: i64) -> list<i64, 2> {
    when { return at(value, key) }
}

export struct NativeRecord {
    count: i64
    label: str
}
export fn map_child_struct(value: map<i64, NativeRecord>, key: i64) -> NativeRecord {
    when { return at(value, key) }
}

export fn list_at(value: list<i64, unbounded>, index: i64) -> i64 {
    when { return at(value, index) }
}

export fn window_at(value: rolling<i64, 3, 1>, index: i64) -> i64 {
    when { return at(value, index) }
}

export fn window_time_at(value: rolling<i64, 3, 1>, index: i64) -> datetime {
    when { return time_at(value, index) }
}

export fn window_front(value: rolling<i64, 3, 1>) -> i64 {
    when { return front(value) }
}

export fn window_back(value: rolling<i64, 3, 1>) -> i64 {
    when { return back(value) }
}

export fn window_removed_value(value: rolling<i64, 3, 1>) -> i64 {
    when {
        if native::has_removed_value(value) { return removed_value(value) }
    }
}

export fn map_keys_changed(value: map<i64, f64>) -> bool {
    when { return modified(key_set(value)) }
}

export fn map_keys_only(value: map<i64, f64>) -> bool {
    when modified(key_set(value)) { return true }
}

export fn map_key_delta_count(value: map<i64, f64>) -> i64 {
    when {
        let ks = key_set(value)
        var count = 0
        for k in elements(ks, added) { count += 1 }
        for k in elements(ks, removed) { count += 1 }
        return count
    }
}

# hgraph.native is the small C++ substrate beneath HGL library nodes. The
# node remains responsible for scheduling; the selected native function sees
# either the current scalar value or the live collection input view.
export fn endpoint_valid(value: signal) -> bool {
    when {
        return native::valid(value)
    }
}

# A concrete consumer proves that an imported `signal` native parameter
# accepts an ordinary typed endpoint rather than only a literal signal.
export fn float_endpoint_valid(value: f64) -> bool {
    when {
        return native::valid(value)
    }
}

export fn endpoint_all_valid(value: signal) -> bool {
    when {
        return native::all_valid(value)
    }
}

export fn endpoint_modified(value: signal) -> bool {
    when {
        return native::modified(value)
    }
}

export fn endpoint_last_modified(value: signal) -> datetime {
    when {
        return native::last_modified(value)
    }
}

