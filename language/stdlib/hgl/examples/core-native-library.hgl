export fn set_length(value: set<i64>) -> i64 {
    when {
        return native::len(value)
    }
}

export fn map_length(value: map<i64, f64>) -> i64 {
    when {
        return native::len(value)
    }
}

export fn map_is_empty(value: map<i64, f64>) -> bool {
    when {
        return native::is_empty(value)
    }
}

export fn window_length(value: rolling<i64, 3, 1>) -> i64 {
    when {
        return native::len(value)
    }
}

export fn window_is_empty(value: rolling<i64, 3, 1>) -> bool {
    when {
        return native::is_empty(value)
    }
}

export fn set_is_empty(value: set<i64>) -> bool {
    when {
        return native::is_empty(value)
    }
}

# Sample a passive endpoint, including before its first value. The clock is
# the only activation/validity requirement. Bits: bound=1, active=2, valid=4,
# modified=8, clock-active=16.
export fn endpoint_status(value: signal, clock: bool) -> i64 {
    when modified(clock) && valid(clock) {
        var status = 0
        if native::bound(value) { status += 1 }
        if native::active(value) { status += 2 }
        if native::valid(value) { status += 4 }
        if native::modified(value) { status += 8 }
        if native::active(clock) { status += 16 }
        return status
    }
}

export fn text_contains(value: str, needle: str) -> bool {
    when { return native::contains(value, needle) }
}

export fn text_starts_with(value: str, prefix: str) -> bool {
    when { return native::starts_with(value, prefix) }
}

export fn text_ends_with(value: str, suffix: str) -> bool {
    when { return native::ends_with(value, suffix) }
}

export fn window_capacity(value: rolling<i64, 3, 1>) -> i64 {
    when { return native::capacity(value) }
}

export fn window_period(value: rolling<i64, 3, 1>) -> i64 {
    when { return native::period(value) }
}

export fn window_min_period(value: rolling<i64, 3, 2>) -> i64 {
    when { return native::min_period(value) }
}

export fn window_is_full(value: rolling<i64, 3, 1>) -> bool {
    when { return native::is_full(value) }
}

export fn window_first_modified(value: rolling<i64, 3, 1>) -> datetime {
    when { return native::first_modified(value) }
}

# A clock also samples evaluations without a window tick: eviction is a
# current-evaluation fact, not a latched "has ever evicted" flag.
export fn window_has_removed_value(value: rolling<i64, 3, 1>, clock: bool) -> bool {
    when modified(clock) && valid(value, clock) {
        return native::has_removed_value(value)
    }
}
