// Operators are nominal generic contracts implemented by fn candidates.

module examples.operators_and_generics

use hgraph.std::{mean}

operator summarize<
    T,
    const max_size: i64,
    const min_size: i64
>(window: rolling<T, max_size, min_size>) -> T

fn summarize<
    const max_size: i64,
    const min_size: i64
>(window: rolling<f64, max_size, min_size>) -> f64 =>
    mean(window)

fn summarize_full_window(window: rolling<f64, 20>) -> f64 =>
    summarize(window)
