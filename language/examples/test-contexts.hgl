module examples.test_contexts

export fn identity(value: i64) -> i64 => value

test {
    fn fixture(value: i64) -> i64 {
        when { return value + 1 }
    }

    test fixture_ticks {
        assert eval(fixture, value: [1, 2]) == [2, 3]
    }
}

test {
    test shared_fixture {
        assert eval(fixture, value: [3]) == [4]
        assert eval(identity, value: [3]) == [3]
    }
}
