# An outputless temporal conditional controls child-graph lifetime without
# manufacturing a dummy result. The second sink remains outside the switch.

module examples.conditional_sinks

use hgraph.std::{debug_print}

export fn observe(enabled: bool, value: f64) {
    if enabled {
        debug_print("enabled", value)
    }

    debug_print("always", value)
}

# A discarded conditional remains outputless even when the enclosing graph
# returns a value.
export fn observe_and_forward(enabled: bool, value: f64) -> f64 {
    if enabled {
        debug_print("enabled", value)
    }

    value
}
