// Canonical containers are temporal structures unless atomic stops recursion.

module examples.structural_types

use hgraph.std::{map}

export struct Quote {
    bid: f64
    ask: f64
    currency: str = "USD"
    venue: str = null
}

export struct Box<T> {
    value: T
}

export struct Range<T>
requires T in {i64, f64}
{
    lower: T
    upper: T
}

export abstract struct ValueBox<T> {
    value: T
}

export struct LabeledValue<U>: ValueBox<U> {
    label: str
}

export abstract struct Pair<A, B> {
    first: A
    second: B
}

export struct Swap<X, Y>: Pair<Y, X> {}

export abstract struct Instrument {
    symbol: str
    venue: str = null
}

export struct Future: Instrument {
    venue = "XCME"
    expiry: date
}

export fn make_quote(bid: f64, ask: f64) -> Quote =>
    Quote(bid: bid, ask: ask)

fn boxed_midpoint(value: f64) -> atomic<Box<f64>> =>
    Box<f64>(value: value)

export fn make_swapped(first: f64, second: i64) -> Swap<i64, f64> =>
    Swap<i64, f64>(first: first, second: second)

fn bid_delta(value: f64) -> Quote {
    when modified(value) && valid(value) {
        return delta<Quote>(bid: value)
    }
}

fn notionals(
    prices: map<str, f64>,
    quantities: map<str, i64>
) -> map<str, f64> =>
    map(
        prices,
        quantities,
        fn(price, quantity) => price * quantity
    )

fn atomic_midpoint(
    tob: atomic<tuple<f64, f64>>
) -> f64 =>
    (tob[0] + tob[1]) / 2.0
