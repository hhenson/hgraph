@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(hgraph CONFIG)

# A STATIC hgraph::web archive references OpenSSL and libcurl symbols at the
# consumer's final link; Beast/Asio are header-only and already compiled into
# the archive (RFC 0024, packaging).  A SHARED hgraph::web carries them.
get_target_property(_hgraph_web_type hgraph::web TYPE)
if(_hgraph_web_type STREQUAL "STATIC_LIBRARY")
    # OpenSSL travels in the export set as a LINK_ONLY imported reference;
    # curl was confined to the build tree and is re-supplied here.
    find_dependency(OpenSSL)
    find_dependency(CURL)
    target_link_libraries(hgraph::web INTERFACE CURL::libcurl)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/hgraphWebTargets.cmake")

check_required_components(hgraph-web)
