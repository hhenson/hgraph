@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(hgraph CONFIG)

# nghttp2, curl, and Boost are PRIVATE to the extension and arrive with their
# translation units (RFC 0024, packaging). Their find_dependency calls land in
# the same change as the transports that link them.

include("${CMAKE_CURRENT_LIST_DIR}/hgraphWebTargets.cmake")

check_required_components(hgraph-web)
