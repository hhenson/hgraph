  "features": [
    "conversion:text",
    "operation:str_",
    "shape:TSD"
  ],
  "id": "issue-819-str-tsd-quotes-its-keys",
  "inputs": {
    "ts": [
      {
        "a": 1,
        "b": 2
      },
      {
        "a": {
          "$remove": true
        }
      }
    ]
  },
  "parameters": {
    "input_type": "tsd",
    "operation": "str_"
  },
  "schema_version": 1,
  "template": "unary_operator"
}
