          },
          "c": 3
        }
      },
      {
        "y": {
          "$remove": true
        }
      }
    ]
  },
  "parameters": {
    "operation": "unpartition"
  },
  "features": [
    "operation:unpartition",
    "shape:TSD",
    "lifecycle:key-removal"
  ]
